{
  "manifest_version": 3,
  "name": "Evercraft HumanFilter",
  "short_name": "HumanFilter",
  "version": "0.1.3",
  "description": "Choose what AI-related content appears in your social feeds. Local, transparent, reversible filters.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HumanFilter controls",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "rules.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
