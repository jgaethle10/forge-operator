# PUBLIC STATIC ONLY. STAGED, NOT INSTALLED OR PUBLISHED.
# Deploy on an Evercraft-controlled server and owned domain with verified TLS.
# NEVER reverse proxy the private Kennedy operator server from this origin.
# Keep the public file_server rooted only in public/ with explicit path allowlist.

{$KENNEDY_PUBLIC_DOMAIN} {
    root * /ABSOLUTE/OWNED/REPO/products/kennedy-space-station/public
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }
    @public_index path /
    rewrite @public_index /index.html
    @static_pages path /index.html /favicon.svg
    handle @static_pages {
        header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; font-src 'none'; script-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        file_server
    }
    handle /explore.html {
        # The self-contained interactive Canvas needs one inline script.
        # No network or private application endpoints can be contacted.
        header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; font-src 'none'; script-src 'unsafe-inline'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        file_server
    }
    handle {
        respond "Not found" 404
    }
}
