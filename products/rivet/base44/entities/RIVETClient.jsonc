{
  "name": "RIVETClient",
  "type": "object",
  "description": "Client record for the RIVET reporting company. Contains customer relationship data only, not generalized RIVET intelligence.",
  "properties": {
    "client_key": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "billing_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "prospect",
        "active",
        "paused",
        "archived"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "client_key",
    "company_name",
    "status",
    "created_at",
    "updated_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.rivet_owner": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.rivet_owner": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.rivet_owner": true
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}