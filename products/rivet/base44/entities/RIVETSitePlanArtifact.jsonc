{
  "name": "RIVETSitePlanArtifact",
  "type": "object",
  "description": "Hash-bound site-plan artifact imported from AliEV into the RIVET team workspace. RIVET owns the local copy after import; customer visibility is never implied.",
  "properties": {
    "artifact_key": {
      "type": "string"
    },
    "source_system": {
      "type": "string",
      "default": "AliEV"
    },
    "source_app_id": {
      "type": "string"
    },
    "source_asset_key": {
      "type": "string"
    },
    "source_package_key": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "evidence_status": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "geometry_sha256": {
      "type": "string"
    },
    "renderer_revision": {
      "type": "string"
    },
    "qa_state": {
      "type": "string"
    },
    "review_state": {
      "type": "string"
    },
    "sales_state": {
      "type": "string"
    },
    "artifact_state": {
      "type": "string",
      "enum": [
        "importing",
        "ready",
        "failed",
        "superseded"
      ],
      "default": "importing"
    },
    "chunk_count": {
      "type": "number",
      "default": 0
    },
    "byte_count": {
      "type": "number",
      "default": 0
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "imported_by_email": {
      "type": "string"
    },
    "source_grant_sha256": {
      "type": "string"
    },
    "customer_visible": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "artifact_key",
    "source_asset_key",
    "site_id",
    "source_sha256",
    "artifact_state",
    "imported_at",
    "updated_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.rivet_owner": true
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}