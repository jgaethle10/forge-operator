{
  "schema": "evercraft.compute.workload.v1",
  "workload_id": "forge-operator",
  "owner": "Evercraft",
  "control_plane": "Systemia",
  "deployment_surface": "Yard Operator",
  "runtime_fabric": "Evercraft Compute",
  "provider_policy": {
    "preferred": "evercraft-owned",
    "fallback": "none"
  },
  "release": {
    "repository": "jgaethle10/forge-operator",
    "branch": "main",
    "container_image": "ghcr.io/jgaethle10/forge-operator:latest",
    "immutable_image_pattern": "ghcr.io/jgaethle10/forge-operator:<git-sha>"
  },
  "service": {
    "port": 3000,
    "health_path": "/api/health",
    "capabilities_path": "/api/capabilities",
    "commercial_path": "/api/commercial",
    "public_discovery": [
      "/llms.txt",
      "/.well-known/evercraft-capabilities.json",
      "/api/chum/attribution",
      "/chum/freshness.xml",
      "/chum/freshness.json",
      "/chum/crawl-state.json",
      "/sitemap.xml",
      "/chum/hot/",
      "/chum/hot/index.json",
      "/mcp/ibmi-rescue",
      "/mcp/foundry-app-escape",
      "/mcp/site-survive"
    ],
    "specialist_mcp_paths": [
      "/mcp/ibmi-rescue",
      "/mcp/foundry-app-escape",
      "/mcp/site-survive"
    ]
  },
  "environment": {
    "required": [
      "GEMINI_API_KEY"
    ],
    "optional_human_gated": [
      "FORGE_CHECKOUT_URL"
    ],
    "optional_runtime": [
      "CHUM_PUBLIC_ORIGIN",
      "CHUM_ATTRIBUTION_SECRET",
      "CHUM_ATTRIBUTION_SINK_URL",
      "CHUM_ATTRIBUTION_SINK_TOKEN",
      "CHUM_ATTRIBUTION_INGEST_TOKEN"
    ],
    "rules": {
      "CHUM_PUBLIC_ORIGIN": "May be set only to a public route independently verified in the current Yard DeploymentReceipt.",
      "attribution": "Missing attribution configuration must degrade to untracked public discovery, never fabricated referral or revenue receipts."
    }
  },
  "capacity": {
    "mode": "dynamic-lease",
    "node_class": "physical_linux",
    "provider_key": "evercraft-owned",
    "workload_classes": [
      "systemia.chum-public-origin.v1",
      "systemia.specialist-handoff-mcp.v1",
      "systemia.public-edge.v1"
    ],
    "public_origin": {
      "workload_class": "systemia.chum-public-origin.v1",
      "mode": "read_only_static_discovery",
      "public_route_requires_independent_verification": true,
      "verified_origin_receipt": "/.well-known/evercraft-runtime-origin.json"
    },
    "specialist_handoff": {
      "workload_class": "systemia.specialist-handoff-mcp.v1",
      "mode": "read_only_mcp_handoff",
      "public_route_requires_independent_verification": true,
      "health_path": "/health",
      "mcp_paths": [
        "/mcp/ibmi-rescue",
        "/mcp/foundry-app-escape",
        "/mcp/site-survive"
      ]
    },
    "public_edge": {
      "workload_class": "systemia.public-edge.v1",
      "protocol": "evercraft.public-route.v1",
      "modes": [
        "proof_loopback",
        "wildcard_https"
      ],
      "control_plane": "private_loopback_or_token_bound",
      "public_https_requires_tls_material": true,
      "route_binding_requires_deployment_receipt": true,
      "route_binding_requires_instance_match": true,
      "founder_login_required": false
    }
  },
  "release_gates": [
    "ci_pass",
    "health_pass",
    "capability_manifest_present",
    "public_route_verified"
  ],
  "receipt_requirements": [
    "release_sha",
    "image_digest",
    "node_lease_id",
    "live_route",
    "health_verification",
    "deployed_at",
    "rollback_target"
  ]
}
