{
  "schema": "evercraft.compute.workload.v1",
  "workload_id": "forge-operator",
  "owner": "Evercraft",
  "control_plane": "Systemia",
  "deployment_surface": "Yard Operator",
  "runtime_fabric": "Evercraft Compute",
  "provider_policy": {
    "preferred": "evercraft-owned",
    "fallback": "saban-authorized-zero-spend",
    "commercial_fallback": "human_authorization_required",
    "visibility_is_not_authorization": true,
    "max_autonomous_spend_usd": 0
  },
  "release": {
    "repository": "jgaethle10/forge-operator",
    "branch": "main",
    "container_image": "ghcr.io/jgaethle10/forge-operator:latest",
    "immutable_image_pattern": "ghcr.io/jgaethle10/forge-operator:<git-sha>",
    "immutable_digest_pattern": "ghcr.io/jgaethle10/forge-operator@sha256:<digest>",
    "yard_workload_class": "systemia.forge-operator-runtime.v1"
  },
  "service": {
    "port": 3000,
    "health_path": "/api/health",
    "capabilities_path": "/api/capabilities",
    "commercial_path": "/api/commercial",
    "public_discovery": [
      "/llms.txt",
      "/.well-known/evercraft-capabilities.json",
      "/api/chum/attribution",
      "/chum/freshness.xml",
      "/chum/freshness.json",
      "/chum/crawl-state.json",
      "/sitemap.xml",
      "/chum/hot/",
      "/chum/hot/index.json",
      "/mcp/ibmi-rescue",
      "/mcp/foundry-app-escape",
      "/mcp/site-survive",
      "/api/systemia-university/benchmarks",
      "/api/systemia-university/benchmarks/{missionKey}",
      "/api/systemia-university/evaluate"
    ],
    "specialist_mcp_paths": [
      "/mcp/ibmi-rescue",
      "/mcp/foundry-app-escape",
      "/mcp/site-survive"
    ],
    "private_authenticated_paths": [
      "/api/remote-operator/health",
      "/mcp/evercraft-remote"
    ]
  },
  "environment": {
    "required": [
      "GEMINI_API_KEY"
    ],
    "optional_human_gated": [
      "FORGE_CHECKOUT_URL"
    ],
    "optional_runtime": [
      "CHUM_PUBLIC_ORIGIN",
      "CHUM_ATTRIBUTION_SECRET",
      "CHUM_ATTRIBUTION_SINK_URL",
      "CHUM_ATTRIBUTION_SINK_TOKEN",
      "CHUM_ATTRIBUTION_INGEST_TOKEN",
      "EVERCRAFT_REMOTE_OPERATOR_CAPACITY_ENDPOINT",
      "EVERCRAFT_REMOTE_OPERATOR_CONTROL_TOKEN",
      "EVERCRAFT_REMOTE_OPERATOR_CLIENT_TOKEN"
    ],
    "rules": {
      "CHUM_PUBLIC_ORIGIN": "May be set only to a public route independently verified in the current Yard DeploymentReceipt.",
      "attribution": "Missing attribution configuration must degrade to untracked public discovery, never fabricated referral or revenue receipts.",
      "remote_operator": "Remote Operator gateway configuration is optional and must fail closed when incomplete. The client bearer and NodeSeed remote control grant must be distinct; neither secret may be emitted in health, manifests, logs, receipts, or client responses."
    }
  },
  "capacity": {
    "mode": "dynamic-lease",
    "node_class": "physical_linux",
    "provider_key": "evercraft-owned",
    "workload_classes": [
      "systemia.forge-operator-runtime.v1",
      "systemia.chum-public-origin.v1",
      "systemia.specialist-handoff-mcp.v1",
      "systemia.public-edge.v1",
      "systemia.evercraft-home.v1",
      "systemia.evercraft-web-browser.v1",
      "systemia.forensic-record-runtime.v1",
      "systemia.forensic-record-public-runtime.v1"
    ],
    "public_origin": {
      "workload_class": "systemia.chum-public-origin.v1",
      "mode": "read_only_static_discovery",
      "public_route_requires_independent_verification": true,
      "verified_origin_receipt": "/.well-known/evercraft-runtime-origin.json"
    },
    "specialist_handoff": {
      "workload_class": "systemia.specialist-handoff-mcp.v1",
      "mode": "read_only_mcp_handoff",
      "public_route_requires_independent_verification": true,
      "health_path": "/health",
      "mcp_paths": [
        "/mcp/ibmi-rescue",
        "/mcp/foundry-app-escape",
        "/mcp/site-survive"
      ]
    },
    "public_edge": {
      "workload_class": "systemia.public-edge.v1",
      "protocol": "evercraft.public-route.v1",
      "modes": [
        "proof_loopback",
        "wildcard_https"
      ],
      "control_plane": "private_loopback_or_token_bound",
      "public_https_requires_tls_material": true,
      "route_binding_requires_deployment_receipt": true,
      "route_binding_requires_instance_match": true,
      "founder_login_required": false
    },
    "evercraft_home": {
      "workload_class": "systemia.evercraft-home.v1",
      "mode": "authenticated_private_origin",
      "auth": "evercraft_identity_plus_passport",
      "public_route_requires_independent_verification": true,
      "health_path": "/api/health",
      "provider_independent_boot": true,
      "identity": "evercraft-owned",
      "identity_state_required": true,
      "passport_state_required": true
    },
    "competition_browser": {
      "workload_class": "systemia.evercraft-web-browser.v1",
      "placement": "saban_then_yard",
      "require_authorized_zero_cost_node": true,
      "require_session_attestation": true,
      "require_persistent_storage": true,
      "paid_capacity_authority": "human_gate"
    },
    "forensic_record": {
      "workload_class": "systemia.forensic-record-runtime.v1",
      "mode": "private_content_addressed_evidence_runtime",
      "public_route_requires_independent_verification": true,
      "health_path": "/health",
      "public_edge_separate": true,
      "base44_runtime_required": false
    },
    "forensic_record_public": {
      "workload_class": "systemia.forensic-record-public-runtime.v1",
      "mode": "public_read_only_safe_projection",
      "shared_state_with": "systemia.forensic-record-runtime.v1",
      "public_route_requires_independent_verification": true,
      "health_path": "/health",
      "write_routes_exposed": false,
      "protected_domains_exposed": false,
      "base44_runtime_required": false,
      "canonical_domain_cutover": false
    },
    "forge_operator": {
      "workload_class": "systemia.forge-operator-runtime.v1",
      "mode": "immutable_container_public_application",
      "artifact_transport": "ghcr.io/jgaethle10/forge-operator",
      "immutable_release_sha_required": true,
      "image_digest_required": true,
      "release_execution_receipt_required": true,
      "container_engine_required": true,
      "arbitrary_image_execution": false,
      "required_environment": [
        "GEMINI_API_KEY"
      ],
      "health_path": "/api/health",
      "public_route_requires_independent_verification": true,
      "route_binding_requires_deployment_receipt": true,
      "route_binding_requires_instance_match": true,
      "benchmark_discovery_path": "/api/systemia-university/benchmarks",
      "benchmark_evaluate_path": "/api/systemia-university/evaluate",
      "benchmark_remote_persistence": false,
      "benchmark_public_write_allowed": false,
      "deploy_state_distinctions": [
        "source_merged",
        "release_artifact_published",
        "compute_deployed",
        "public_route_verified"
      ]
    }
  },
  "release_gates": [
    "ci_pass",
    "health_pass",
    "capability_manifest_present",
    "release_execution_receipt_present",
    "immutable_image_digest_verified",
    "university_benchmark_ingress_healthy",
    "public_route_verified"
  ],
  "receipt_requirements": [
    "release_sha",
    "image_digest",
    "node_lease_id",
    "live_route",
    "health_verification",
    "deployed_at",
    "rollback_target",
    "release_execution_receipt_ref",
    "deployment_receipt_hash",
    "university_benchmark_ingress_verification"
  ]
}
