{
  "schema": "evercraft.saban.multiplication-registry.v1",
  "purpose": "Bounded adversarial planning review for RIVET hosting choices. This registry grants no deployment or RIVET mutation authority.",
  "defaults": {
    "default_logical_agents": 45,
    "max_logical_agents": 45,
    "default_physical_workers": 5,
    "max_physical_workers": 8,
    "lease_seconds": 120,
    "side_effect_policy": "deny_unless_declared"
  },
  "software": [
    {
      "software_id": "rivet-hosting-review",
      "name": "RIVET Hosting Migration Review",
      "aliases": [
        "rivet hosting review",
        "rivet migration review"
      ],
      "adapter": "systemia/migrations/rivet-hosting/saban-review-adapter.mjs",
      "default_logical_agents": 45,
      "max_logical_agents": 45,
      "default_physical_workers": 5,
      "max_physical_workers": 8,
      "lease_seconds": 120,
      "roles": [
        "brand_guard",
        "partner_control_guard",
        "reliability_guard",
        "cost_guard",
        "rollback_guard",
        "portability_guard",
        "security_guard",
        "data_authority_guard",
        "infrastructure_skeptic"
      ],
      "work_sources": [
        {
          "file": "governance/rivet-hosting-migration/decision-matrix.json",
          "field": "options",
          "kind": "hosting_option",
          "key_field": "id"
        }
      ],
      "reconciler": {
        "adapter_export": "reconcile",
        "once_per_swarm": true
      },
      "side_effects": {
        "default": "deny",
        "local_generated_files": true,
        "local_receipts": true,
        "external_network": false,
        "production_mutation": false,
        "rivet_mutation": false,
        "dns_changes": false,
        "checkout": false,
        "payment_obligation": false
      },
      "max_attempts_per_job": 2,
      "budget": {
        "max_logical_agents": 45,
        "max_physical_workers": 8,
        "max_work_items": 5,
        "max_attempts_per_job": 2
      },
      "assignment_strategy": "role_item_cartesian",
      "quality": {
        "minimum_completion_ratio": 1,
        "dead_letter_allowed": false,
        "require_all_roles": true,
        "require_reconciliation": true,
        "enforcement": "fail_execution"
      },
      "resources": {
        "minimum_node_cpu_units": 1,
        "minimum_node_memory_mb": 64,
        "cpu_units_per_worker": 1,
        "memory_mb_per_worker": 64,
        "require_capacity_hint": false
      }
    }
  ]
}
