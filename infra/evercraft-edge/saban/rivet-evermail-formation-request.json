{
  "schema": "evercraft.saban.evermail-formation-request.v1",
  "formation_id": "rivet-evermail-bootstrap",
  "service_id": "rivet-mail",
  "logical_uri": "evercraft://mail/rivet",
  "desired_state": {
    "workload_class": "systemia.evermail.v1",
    "runtime_fabric": "Evercraft Compute",
    "provider_policy": "evercraft-owned-only",
    "public_domain": "rivet.systemiacommandcenters.com",
    "minimum_healthy_mail_replicas": 1,
    "attestation_required": true,
    "persistent_storage_required": true,
    "public_ingress_required": true,
    "zero_spend_only": true
  },
  "mailbox_manifest": "systemia/domain-authority/rivet-mailboxes.json",
  "gates": [
    "capacity_discovered",
    "field_attestation_verified",
    "mail_runtime_health_green",
    "public_domain_delegation_verified",
    "mx_publicly_resolvable",
    "spf_present",
    "dkim_present",
    "dmarc_present",
    "tls_reporting_present",
    "mta_sts_present",
    "reverse_dns_matches_mail_host",
    "smtp_starttls_trusted",
    "mailbox_auth_receipt_present",
    "backup_restore_receipt_present"
  ],
  "first_customer_sender": "invoices@rivet.systemiacommandcenters.com",
  "fail_closed": true
}
