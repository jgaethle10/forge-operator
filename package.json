{
  "name": "evercraft-forge-operator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:ai": "node scripts/validate-ai-conformance.mjs",
    "chum": "node systemia/chum/chum.mjs",
