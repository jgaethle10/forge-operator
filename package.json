    "check": "npm run test:signal-fabric-engine && npm run test:signal-fabric && npm run check:workflow-noise && npm run test:release-policy && npm run proof:systemia && npm run proof:control-plane && npm run proof:offline-continuity && npm run proof:blackout-resilience && npm run proof:continuity-kernel && npm run proof:partition-reconciliation && npm run test:media-studio && npm run chum:mirror && npm run chum:crawl-pressure && npm run test:ibmi-rescue-discovery && npm run check:ai && npm run test:openai-plugin-submission && npm run test:chum-crawler-policy && npm run test:chum-capabilities && npm run test:chum-hunter && npm run test:chum-ard-strike && npm run test:chum-live-intent && npm run check:saban-contracts && npm run proof:saban-kernel && npm run proof:beast-mode && npm run proof:beast-football && npm run saban:discovery && npm run saban:discovery:check && npm run test:saban-revenue && npm run test:chum-revenue && npm run test:chum-surfaces && npm run test:chum-router && npm run test:chum-index && npm run test:chum-answers && npm run test:forensiscope-developer-hub && npm run test:forensiscope-editorial && npm run test:forensiscope-seo-mesh && npm run test:chum-crawl-pressure && npm run test:chum-public-origin && npm run proof:yard-chum-public-origin && npm run check:probes && npm run lint && npm run build",
    "proof:saban-network": "node systemia/network/saban-network-proof.mjs --agents 10000 --out ./saban-proof-output",
    "test:release-policy": "node systemia/release/release-policy.test.mjs && node systemia/release/scoped-approval.test.mjs",
    "media:studio": "tsx systemia/media-studio/cli.ts",
    "test:media-studio": "node --import tsx --test systemia/media-studio/director.test.ts",
    "check:probes": "node scripts/validate-nexus-cross-llm-probes.mjs",
    "probe:cross-llm": "node scripts/run-nexus-cross-llm-probes.mjs",
    "chum:mirror": "node systemia/chum/build-public-mirror.mjs",
    "chum:sync": "node systemia/chum/sync-public-discovery.mjs",
    "check:workflow-noise": "node scripts/validate-workflow-noise.mjs",
    "chum:revenue": "node systemia/chum/build-revenue-watershed.mjs",
    "test:chum-router": "node systemia/chum/discovery-router.test.mjs",
    "proof:organism": "node systemia/organism/proof.mjs",
    "proof:goal-runtime": "node systemia/organism/goal-runtime.proof.mjs",
    "proof:systemia": "npm run proof:organism && npm run proof:goal-runtime && npm run proof:goal-store && npm run proof:legacy-rescue-watch",
    "goal": "node systemia/organism/goal-cli.mjs",
    "proof:goal-store": "node systemia/organism/goal-store.proof.mjs",
    "chum:index": "node systemia/chum/build-pain-index.mjs",
    "test:chum-index": "npm run chum:index && node tests/chum-pain-index.test.mjs",
    "chum:answers": "node systemia/chum/build-answer-doors.mjs && node systemia/chum/build-observed-miss-pages.mjs",
    "test:chum-answers": "npm run chum:index && npm run chum:answers && node tests/chum-answer-doors.test.mjs && node tests/chum-observed-miss-pages.test.mjs",
    "saban:discovery": "node systemia/saban/discovery-swarm.mjs --emit",
    "saban:discovery:check": "node systemia/saban/discovery-swarm.mjs --strict",
    "saban:watershed": "npm run saban:discovery && npm run saban:revenue && npm run chum:all",
    "chum:capabilities": "node systemia/chum/build-capability-mirror.mjs",
    "test:chum-revenue": "npm run chum:revenue && npm run test:chum-start-corridor && node tests/chum-revenue-watershed.test.mjs",
    "test:chum-capabilities": "npm run chum:capabilities && node tests/chum-capability-mirrors.test.mjs",
    "test:signal-fabric": "node systemia/signal-fabric/router.test.mjs",
    "test:signal-fabric-engine": "node systemia/signal-fabric/engine.test.mjs && node systemia/signal-fabric/adapters/github-actions.test.mjs",
    "chum:router-recall": "node systemia/chum/router-recall.mjs",
    "proof:offline-continuity": "node systemia/network/offline-continuity-proof.mjs --require-local-inference --out ./offline-continuity-output",
    "test:chum-crawler-policy": "node systemia/chum/discovery-lane-policy.test.mjs",
    "chum:commerce-canary": "node systemia/chum/commerce-canary.mjs",
    "chum:hunt": "node systemia/chum/llm-hunter.mjs",
    "chum:hunt:offline": "node systemia/chum/llm-hunter.mjs --offline",
    "test:chum-hunter": "node tests/chum-llm-hunter.test.mjs",
    "chum:ard-strike": "node systemia/chum/ard-strike.mjs",
    "chum:ard-strike:offline": "node systemia/chum/ard-strike.mjs --offline",
    "test:chum-ard-strike": "node tests/chum-ard-strike.test.mjs",
    "test:chum-live-intent": "node tests/chum-live-intent-hunter.test.mjs",
    "saban:revenue": "node systemia/saban/revenue-swarm.mjs",
    "test:saban-revenue": "node tests/saban-revenue-swarm.test.mjs",
    "test:openai-plugin-submission": "node scripts/validate-openai-plugin-submission.mjs",
    "test:chum-start-corridor": "node tests/chum-start-corridor.test.mjs",
    "proof:legacy-rescue-watch": "node systemia/organism/legacy-rescue-watch.proof.mjs && npm run proof:legacy-rescue-public-scan && npm run proof:legacy-rescue-link-discovery",
    "test:chum-surfaces": "npm run chum:mirror && node systemia/chum/discovery-surfaces.test.mjs",
    "test:ibmi-rescue-discovery": "node tests/ibmi-rescue-discovery.test.mjs",
    "run:legacy-rescue-watch": "node systemia/organism/legacy-rescue-watch-runner.mjs",
    "scan:legacy-rescue-watch": "node systemia/organism/legacy-rescue-public-scan.mjs",
    "proof:legacy-rescue-public-scan": "node systemia/organism/legacy-rescue-public-scan.proof.mjs",
    "proof:legacy-rescue-link-discovery": "node systemia/organism/legacy-rescue-link-discovery.proof.mjs",
    "chum:crawl-pressure": "node systemia/chum/crawl-accelerator.mjs",
    "chum:crawl-pressure:broadcast": "node systemia/chum/crawl-accelerator.mjs --broadcast",
    "test:chum-crawl-pressure": "node tests/chum-crawl-accelerator.test.mjs",
    "saban:multiply": "node systemia/saban/multiplier.mjs",
    "saban:chum:10000": "node systemia/saban/multiplier.mjs --software chum --agents 10000 --workers 32",
    "proof:saban-kernel": "node systemia/saban/kernel-proof.mjs",
    "proof:saban-chum": "node systemia/saban/multiplier.mjs --software chum --agents 512 --workers 16 --execute",
    "proof:saban-media": "node systemia/saban/multiplier.mjs --software media-pipeline --inventory systemia/saban/fixtures/media-job.json --agents 32 --workers 4 --execute --reconcile",
    "check:saban-contracts": "node systemia/saban/contract-doctor.mjs",
    "saban:formation": "node systemia/saban/formation.mjs",
    "proof:saban-formation": "node systemia/saban/formation.mjs --request systemia/saban/fixtures/formation-proof.json --execute",
    "proof:saban-nodeseed-multiplier": "node systemia/network/saban-multiplier-nodeseed-proof.mjs",
    "proof:blackout-resilience": "node systemia/network/blackout-resilience-proof.mjs --out ./blackout-resilience-output",
    "proof:continuity-kernel": "node systemia/network/continuity-kernel-proof.mjs",
    "test:forensiscope-developer-hub": "npm run chum:mirror && node tests/forensiscope-developer-hub.test.mjs",
    "proof:beast-mode": "node systemia/beast-mode/proof.mjs",
    "beast-mode:first-seven": "node systemia/beast-mode/proof.mjs",
    "test:chum-public-origin": "node tests/chum-public-origin-runtime.test.mjs",
    "proof:yard-chum-public-origin": "node systemia/yard/chum-public-origin-proof.mjs",
    "test:forensiscope-editorial": "npm run chum:mirror && node tests/forensiscope-editorial.test.mjs",
    "proof:partition-reconciliation": "node systemia/network/partition-reconciliation-proof.mjs",
    "machine:status": "node systemia/control-plane/control-plane.mjs --inventory",
    "proof:control-plane": "node systemia/control-plane/control-plane.proof.mjs",
    "proof:saban-nodeseed-pool": "node systemia/network/saban-nodeseed-pool-proof.mjs",
    "proof:forensiscope-distributed": "node systemia/forensiscope/distributed-proof.mjs",
    "proof:saban-portfolio-archaeology": "node systemia/saban/portfolio-archaeology-proof.mjs",
    "saban:portfolio": "node systemia/saban/multiplier.mjs --software portfolio-archaeology --auto",
    "proof:saban-formation-waves": "node systemia/saban/formation-wave-proof.mjs",
    "proof:beast-football": "node systemia/beast-mode/football.proof.mjs && node systemia/beast-mode/football-engine.proof.mjs",
    "test:forensiscope-seo-mesh": "npm run chum:mirror && node tests/forensiscope-seo-mesh.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
