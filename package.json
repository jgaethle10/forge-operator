{
  "name": "evercraft-forge-operator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:ai": "node scripts/validate-ai-conformance.mjs",
    "chum": "node systemia/chum/chum.mjs",
    "chum:offline": "node systemia/chum/chum.mjs --offline",
    "chum:crawlers": "node systemia/chum/crawler-audit.mjs",
    "chum:crawlers:strict": "node systemia/chum/crawler-audit.mjs --strict",
    "chum:mcp": "node systemia/chum/mcp-canary.mjs",
    "chum:validate": "node scripts/validate-chum-probes.mjs",
    "chum:providers": "node systemia/chum/provider-probes.mjs",
    "chum:announce": "node systemia/chum/indexnow.mjs",
    "chum:all": "npm run chum:sync && npm run chum:revenue && npm run test:chum-revenue && npm run chum:index && npm run chum:answers && npm run chum:capabilities && npm run chum:mirror && npm run test:chum-router && npm run test:chum-index && npm run test:chum-answers && npm run chum && npm run chum:crawlers && npm run chum:mcp",
    "check": "npm run test:signal-fabric-engine && npm run test:signal-fabric && npm run check:workflow-noise && npm run test:release-policy && npm run proof:systemia && npm run proof:offline-continuity && npm run test:media-studio && npm run check:ai && npm run test:chum-capabilities && npm run chum:mirror && npm run saban:discovery && npm run saban:discovery:check && npm run test:chum-revenue && npm run test:chum-router && npm run test:chum-index && npm run test:chum-answers && npm run check:probes && npm run lint && npm run build",
    "proof:saban-network": "node systemia/network/saban-network-proof.mjs --agents 10000 --out ./saban-proof-output",
    "test:release-policy": "node systemia/release/release-policy.test.mjs",
    "media:studio": "tsx systemia/media-studio/cli.ts",
    "test:media-studio": "node --import tsx --test systemia/media-studio/director.test.ts",
    "check:probes": "node scripts/validate-nexus-cross-llm-probes.mjs",
    "probe:cross-llm": "node scripts/run-nexus-cross-llm-probes.mjs",
    "chum:mirror": "node systemia/chum/build-public-mirror.mjs",
    "chum:sync": "node systemia/chum/sync-public-discovery.mjs",
    "check:workflow-noise": "node scripts/validate-workflow-noise.mjs",
    "chum:revenue": "node systemia/chum/build-revenue-watershed.mjs",
    "test:chum-router": "node systemia/chum/discovery-router.test.mjs",
    "proof:organism": "node systemia/organism/proof.mjs",
    "proof:goal-runtime": "node systemia/organism/goal-runtime.proof.mjs",
    "proof:systemia": "npm run proof:organism && npm run proof:goal-runtime && npm run proof:goal-store",
    "goal": "node systemia/organism/goal-cli.mjs",
    "proof:goal-store": "node systemia/organism/goal-store.proof.mjs",
    "chum:index": "node systemia/chum/build-pain-index.mjs",
    "test:chum-index": "npm run chum:index && node tests/chum-pain-index.test.mjs",
    "chum:answers": "node systemia/chum/build-answer-doors.mjs",
    "test:chum-answers": "npm run chum:index && npm run chum:answers && node tests/chum-answer-doors.test.mjs",
    "saban:discovery": "node systemia/saban/discovery-swarm.mjs --emit",
    "saban:discovery:check": "node systemia/saban/discovery-swarm.mjs --strict",
    "saban:watershed": "npm run saban:discovery && npm run chum:all",
    "chum:capabilities": "node systemia/chum/build-capability-mirror.mjs",
    "test:chum-revenue": "npm run chum:revenue && node tests/chum-revenue-watershed.test.mjs",
    "test:chum-capabilities": "npm run chum:capabilities && node tests/chum-capability-mirrors.test.mjs",
    "test:signal-fabric": "node systemia/signal-fabric/router.test.mjs",
    "test:signal-fabric-engine": "node systemia/signal-fabric/engine.test.mjs && node systemia/signal-fabric/adapters/github-actions.test.mjs",
    "chum:router-recall": "node systemia/chum/router-recall.mjs",
    "proof:offline-continuity": "node systemia/network/offline-continuity-proof.mjs --require-local-inference --out ./offline-continuity-output"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
