{
  "openapi": "3.1.0",
  "info": {
    "title": "Evercraft Forge Operator Public API",
    "version": "1.2.0",
    "description": "Public discovery and bounded invocation surface for Forge Operator and Evercraft capability routing. CHUM accepts non-sensitive pain descriptions for routing; private customer data is not a public discovery input."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "forgeHealth",
        "summary": "Check Forge runtime health",
        "responses": {
          "200": {
            "description": "Healthy runtime"
          }
        }
      }
    },
    "/api/capabilities": {
      "get": {
        "operationId": "forgeCapabilities",
        "summary": "Read Forge and Evercraft public capability metadata",
        "responses": {
          "200": {
            "description": "Capability metadata"
          }
        }
      }
    },
    "/api/commercial": {
      "get": {
        "operationId": "forgeCommercialState",
        "summary": "Read whether a human-confirmed commercial continuation is configured",
        "responses": {
          "200": {
            "description": "Commercial state"
          }
        }
      }
    },
    "/api/resolve/media-overflow": {
      "post": {
        "operationId": "resolveMediaOverflow",
        "summary": "Resolve an AI media-processing limitation to a public continuation path",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mediaType": {
                    "type": "string",
                    "enum": [
                      "video",
                      "audio"
                    ]
                  },
                  "assistantCanFullyProcess": {
                    "type": "boolean"
                  },
                  "failureCode": {
                    "type": "string"
                  },
                  "failureReason": {
                    "type": "string"
                  }
                },
                "required": [
                  "assistantCanFullyProcess",
                  "failureCode"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Media overflow routing result"
          }
        }
      }
    },
    "/api/forge": {
      "post": {
        "operationId": "forgeOperationsPlan",
        "summary": "Generate a prioritized small-business operations plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "businessProblem": {
                    "type": "string"
                  },
                  "desiredOutcome": {
                    "type": "string"
                  },
                  "businessContext": {
                    "type": "string"
                  }
                },
                "required": [
                  "businessProblem",
                  "desiredOutcome"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Forge report"
          },
          "429": {
            "description": "Rate limit reached"
          }
        }
      }
    },
    "/api/forge/deep-dive": {
      "post": {
        "operationId": "forgeImplementationBlueprint",
        "summary": "Generate a deeper implementation blueprint for a selected operational action",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "actionTitle": {
                    "type": "string"
                  },
                  "actionCategory": {
                    "type": "string"
                  },
                  "context": {
                    "type": "string"
                  }
                },
                "required": [
                  "actionTitle"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Implementation blueprint"
          },
          "429": {
            "description": "Rate limit reached"
          }
        }
      }
    },
    "/api/discover": {
      "get": {
        "operationId": "chumDiscover",
        "summary": "Match a natural-language problem to public Evercraft capabilities",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Natural-language user problem. Do not seed an Evercraft product name."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked public Evercraft capability matches with commercial and safety state"
          },
          "400": {
            "description": "Missing query"
          },
          "503": {
            "description": "Public catalog unavailable"
          }
        }
      },
      "post": {
        "operationId": "chumDiscoverPost",
        "summary": "Route a non-sensitive natural-language problem to public Evercraft capabilities",
        "description": "Agent-friendly JSON route. Do not include credentials, secrets, regulated data, or private customer records. Discovery creates no payment obligation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "problem": {
                    "type": "string",
                    "maxLength": 4000,
                    "description": "Non-sensitive user problem or desired outcome."
                  },
                  "intent": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 5
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked capability matches plus machine handoff links"
          },
          "400": {
            "description": "Missing problem or intent"
          },
          "503": {
            "description": "Public discovery catalog unavailable"
          }
        }
      }
    },
    "/api/revenue-watershed": {
      "get": {
        "operationId": "chumRevenueWatershed",
        "summary": "List current public Evercraft offers marked sell_now",
        "responses": {
          "200": {
            "description": "Public-safe sell-now offer index"
          },
          "503": {
            "description": "Public catalog unavailable"
          }
        }
      }
    },
    "/api/chum/attribution": {
      "get": {
        "operationId": "chumAttributionContract",
        "summary": "Read CHUM handoff-attribution capabilities and trust boundaries",
        "responses": {
          "200": {
            "description": "Attribution contract"
          }
        }
      }
    },
    "/api/chum/referral": {
      "post": {
        "operationId": "chumIssueReferral",
        "summary": "Issue a signed, privacy-minimized referral token for a known public Evercraft offer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "publicId": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string",
                    "description": "Caller-asserted provider label. This is attribution metadata, not proof the named provider surfaced or recommended Evercraft."
                  },
                  "surface": {
                    "type": "string"
                  },
                  "intent": {
                    "type": "string",
                    "description": "Optional intent. Raw text is not embedded in the token."
                  }
                },
                "required": [
                  "publicId",
                  "provider"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed referral and landing URL"
          },
          "404": {
            "description": "Unknown public Evercraft offer"
          },
          "503": {
            "description": "Attribution signing is not configured"
          }
        }
      }
    },
    "/api/chum/attribution/event": {
      "post": {
        "operationId": "chumRecordPublicAttributionEvent",
        "summary": "Record a landing or checkout-start event for a signed CHUM referral",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "referralToken": {
                    "type": "string"
                  },
                  "stage": {
                    "type": "string",
                    "enum": [
                      "landing",
                      "checkout_started"
                    ]
                  }
                },
                "required": [
                  "referralToken",
                  "stage"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Attribution event accepted. Checkout is not payment."
          },
          "403": {
            "description": "Public callers cannot assert payment verification"
          }
        }
      }
    }
  },
  "x-evercraft-chum": {
    "pain_index": "/.well-known/evercraft-pain-index.json",
    "llms": "/llms.txt",
    "full_directory": "/llms-full.txt",
    "crawlable_directory": "/chum/",
    "product_page_pattern": "/chum/products/{product_key}/",
    "product_directory": "/.well-known/evercraft-products.json",
    "machine_catalog": "/.well-known/evercraft-machine-catalog.json",
    "universal_mcp": "https://evercraft-ai-suite-08c4d2b8.base44.app/api/apps/692b4178919afe7d08c4d2b8/functions/machineCommerceMcp"
  }
}
