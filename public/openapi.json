{
  "openapi": "3.1.0",
  "info": {
    "title": "Evercraft Forge Operator Public API",
    "version": "1.2.0",
    "description": "Public discovery and bounded invocation surface for Forge Operator and Evercraft capability routing."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "forgeHealth",
        "summary": "Check Forge runtime health",
        "responses": {
          "200": {
            "description": "Healthy runtime"
          }
        }
      }
    },
    "/api/capabilities": {
      "get": {
        "operationId": "forgeCapabilities",
        "summary": "Read Forge and Evercraft public capability metadata",
        "responses": {
          "200": {
            "description": "Capability metadata"
          }
        }
      }
    },
    "/api/commercial": {
      "get": {
        "operationId": "forgeCommercialState",
        "summary": "Read whether a human-confirmed commercial continuation is configured",
        "responses": {
          "200": {
            "description": "Commercial state"
          }
        }
      }
    },
    "/api/resolve/media-overflow": {
      "post": {
        "operationId": "resolveMediaOverflow",
        "summary": "Resolve an AI media-processing limitation to a public continuation path",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mediaType": {
                    "type": "string",
                    "enum": [
                      "video",
                      "audio"
                    ]
                  },
                  "assistantCanFullyProcess": {
                    "type": "boolean"
                  },
                  "failureCode": {
                    "type": "string"
                  },
                  "failureReason": {
                    "type": "string"
                  }
                },
                "required": [
                  "assistantCanFullyProcess",
                  "failureCode"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Media overflow routing result"
          }
        }
      }
    },
    "/api/forge": {
      "post": {
        "operationId": "forgeOperationsPlan",
        "summary": "Generate a prioritized small-business operations plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "businessProblem": {
                    "type": "string"
                  },
                  "desiredOutcome": {
                    "type": "string"
                  },
                  "businessContext": {
                    "type": "string"
                  }
                },
                "required": [
                  "businessProblem",
                  "desiredOutcome"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Forge report"
          },
          "429": {
            "description": "Rate limit reached"
          }
        }
      }
    },
    "/api/forge/deep-dive": {
      "post": {
        "operationId": "forgeImplementationBlueprint",
        "summary": "Generate a deeper implementation blueprint for a selected operational action",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "actionTitle": {
                    "type": "string"
                  },
                  "actionCategory": {
                    "type": "string"
                  },
                  "context": {
                    "type": "string"
                  }
                },
                "required": [
                  "actionTitle"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Implementation blueprint"
          },
          "429": {
            "description": "Rate limit reached"
          }
        }
      }
    },
    "/api/discover": {
      "get": {
        "operationId": "chumDiscover",
        "summary": "Match a natural-language problem to public Evercraft capabilities",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Natural-language user problem. Do not seed an Evercraft product name."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked public Evercraft capability matches with commercial and safety state"
          },
          "400": {
            "description": "Missing query"
          },
          "503": {
            "description": "Public catalog unavailable"
          }
        }
      }
    },
    "/api/revenue-watershed": {
      "get": {
        "operationId": "chumRevenueWatershed",
        "summary": "List current public Evercraft offers marked sell_now",
        "responses": {
          "200": {
            "description": "Public-safe sell-now offer index"
          },
          "503": {
            "description": "Public catalog unavailable"
          }
        }
      }
    },
    "/api/chum/attribution": {
      "get": {
        "operationId": "chumAttributionContract",
        "summary": "Read CHUM handoff-attribution capabilities and trust boundaries",
        "responses": {
          "200": {
            "description": "Attribution contract and runtime configuration state"
          }
        }
      }
    },
    "/api/chum/referral": {
      "post": {
        "operationId": "chumIssueReferral",
        "summary": "Issue a signed privacy-minimized referral for a known public Evercraft offer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "publicId": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string",
                    "description": "Caller-asserted provider label; not provider pickup proof."
                  },
                  "surface": {
                    "type": "string"
                  },
                  "intent": {
                    "type": "string",
                    "description": "Optional intent. Raw text is never embedded in the token."
                  }
                },
                "required": [
                  "publicId",
                  "provider"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed referral and target landing URL"
          },
          "404": {
            "description": "Unknown public Evercraft offer"
          },
          "503": {
            "description": "Attribution signing is not configured"
          }
        }
      }
    },
    "/api/chum/attribution/event": {
      "post": {
        "operationId": "chumRecordPublicAttributionEvent",
        "summary": "Record a landing or checkout-start receipt for a signed CHUM referral",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "referralToken": {
                    "type": "string"
                  },
                  "stage": {
                    "type": "string",
                    "enum": [
                      "landing",
                      "checkout_started"
                    ]
                  }
                },
                "required": [
                  "referralToken",
                  "stage"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Attribution receipt accepted. Checkout is not payment."
          },
          "403": {
            "description": "Public callers cannot assert payment verification or revenue."
          }
        }
      }
    }
  }
}
