{
  "openapi": "3.1.0",
  "info": {
    "title": "Evercraft Forge Operator Public API",
    "version": "1.1.0",
    "description": "Public discovery and bounded invocation surface for Forge Operator and Evercraft capability routing."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "forgeHealth",
        "summary": "Check Forge runtime health",
        "responses": {
          "200": {
            "description": "Healthy runtime"
          }
        }
      }
    },
    "/api/capabilities": {
      "get": {
        "operationId": "forgeCapabilities",
        "summary": "Read Forge and Evercraft public capability metadata",
        "responses": {
          "200": {
            "description": "Capability metadata"
          }
        }
      }
    },
    "/api/commercial": {
      "get": {
        "operationId": "forgeCommercialState",
        "summary": "Read whether a human-confirmed commercial continuation is configured",
        "responses": {
          "200": {
            "description": "Commercial state"
          }
        }
      }
    },
    "/api/resolve/media-overflow": {
      "post": {
        "operationId": "resolveMediaOverflow",
        "summary": "Resolve an AI media-processing limitation to a public continuation path",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mediaType": {
                    "type": "string",
                    "enum": [
                      "video",
                      "audio"
                    ]
                  },
                  "assistantCanFullyProcess": {
                    "type": "boolean"
                  },
                  "failureCode": {
                    "type": "string"
                  },
                  "failureReason": {
                    "type": "string"
                  }
                },
                "required": [
                  "assistantCanFullyProcess",
                  "failureCode"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Media overflow routing result"
          }
        }
      }
    },
    "/api/forge": {
      "post": {
        "operationId": "forgeOperationsPlan",
        "summary": "Generate a prioritized small-business operations plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "businessProblem": {
                    "type": "string"
                  },
                  "desiredOutcome": {
                    "type": "string"
                  },
                  "businessContext": {
                    "type": "string"
                  }
                },
                "required": [
                  "businessProblem",
                  "desiredOutcome"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Forge report"
          },
          "429": {
            "description": "Rate limit reached"
          }
        }
      }
    },
    "/api/forge/deep-dive": {
      "post": {
        "operationId": "forgeImplementationBlueprint",
        "summary": "Generate a deeper implementation blueprint for a selected operational action",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "actionTitle": {
                    "type": "string"
                  },
                  "actionCategory": {
                    "type": "string"
                  },
                  "context": {
                    "type": "string"
                  }
                },
                "required": [
                  "actionTitle"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Implementation blueprint"
          },
          "429": {
            "description": "Rate limit reached"
          }
        }
      }
    },
    "/api/resolve": {
      "get": {
        "operationId": "resolveEvercraftCapability",
        "summary": "Resolve natural-language user pain to public Evercraft capabilities",
        "description": "Deterministically matches a user problem against Evercraft's public product-intent catalog. Discovery creates no payment obligation or private authority.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2000
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked bounded capability candidates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "schema": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    },
                    "coordinator": {
                      "type": "string"
                    },
                    "query": {
                      "type": "string"
                    },
                    "match_method": {
                      "type": "string"
                    },
                    "no_match": {
                      "type": "boolean"
                    },
                    "payment_obligation_created": {
                      "type": "boolean"
                    },
                    "private_authority_granted": {
                      "type": "boolean"
                    },
                    "candidates": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "product_key": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "class": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "canonical_url": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "uri"
                          },
                          "matched_terms": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "matched_intents": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "authority": {
                            "type": "string"
                          },
                          "human_confirmation_required": {
                            "type": "boolean"
                          },
                          "boundaries": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "registry_name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "mcp": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "discovery": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "llms": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "universal_fallback": {
                      "type": [
                        "object",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid query"
          }
        }
      },
      "post": {
        "operationId": "resolveEvercraftCapabilityPost",
        "summary": "Resolve a natural-language problem to public Evercraft capabilities",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2000
                  },
                  "problem": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2000
                  },
                  "intent": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2000
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 5
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked bounded capability candidates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "schema": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    },
                    "coordinator": {
                      "type": "string"
                    },
                    "query": {
                      "type": "string"
                    },
                    "match_method": {
                      "type": "string"
                    },
                    "no_match": {
                      "type": "boolean"
                    },
                    "payment_obligation_created": {
                      "type": "boolean"
                    },
                    "private_authority_granted": {
                      "type": "boolean"
                    },
                    "candidates": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "product_key": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "class": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "canonical_url": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "uri"
                          },
                          "matched_terms": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "matched_intents": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "authority": {
                            "type": "string"
                          },
                          "human_confirmation_required": {
                            "type": "boolean"
                          },
                          "boundaries": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "registry_name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "mcp": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "discovery": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "llms": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "universal_fallback": {
                      "type": [
                        "object",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid query"
          }
        }
      }
    }
  }
}
