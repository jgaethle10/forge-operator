{
  "openapi": "3.1.0",
  "info": {
    "title": "Evercraft Forge Operator Public API",
    "version": "1.1.0",
    "description": "Public discovery and bounded invocation surface for Forge Operator and CHUM problem-to-capability routing."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "forgeHealth",
        "summary": "Check Forge runtime health",
        "responses": {
          "200": {
            "description": "Healthy runtime"
          }
        }
      }
    },
    "/api/capabilities": {
      "get": {
        "operationId": "forgeCapabilities",
        "summary": "Read Forge and Evercraft public capability metadata",
        "responses": {
          "200": {
            "description": "Capability metadata"
          }
        }
      }
    },
    "/api/commercial": {
      "get": {
        "operationId": "forgeCommercialState",
        "summary": "Read whether a human-confirmed commercial continuation is configured",
        "responses": {
          "200": {
            "description": "Commercial state"
          }
        }
      }
    },
    "/api/resolve/media-overflow": {
      "post": {
        "operationId": "resolveMediaOverflow",
        "summary": "Resolve an AI media-processing limitation to a public continuation path",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mediaType": {
                    "type": "string",
                    "enum": [
                      "video",
                      "audio"
                    ]
                  },
                  "assistantCanFullyProcess": {
                    "type": "boolean"
                  },
                  "failureCode": {
                    "type": "string"
                  },
                  "failureReason": {
                    "type": "string"
                  }
                },
                "required": [
                  "assistantCanFullyProcess",
                  "failureCode"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Media overflow routing result"
          }
        }
      }
    },
    "/api/forge": {
      "post": {
        "operationId": "forgeOperationsPlan",
        "summary": "Generate a prioritized small-business operations plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "businessProblem": {
                    "type": "string"
                  },
                  "desiredOutcome": {
                    "type": "string"
                  },
                  "businessContext": {
                    "type": "string"
                  }
                },
                "required": [
                  "businessProblem",
                  "desiredOutcome"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Forge report"
          },
          "429": {
            "description": "Rate limit reached"
          }
        }
      }
    },
    "/api/forge/deep-dive": {
      "post": {
        "operationId": "forgeImplementationBlueprint",
        "summary": "Generate a deeper implementation blueprint for a selected operational action",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "actionTitle": {
                    "type": "string"
                  },
                  "actionCategory": {
                    "type": "string"
                  },
                  "context": {
                    "type": "string"
                  }
                },
                "required": [
                  "actionTitle"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Implementation blueprint"
          },
          "429": {
            "description": "Rate limit reached"
          }
        }
      }
    },
    "/api/discover": {
      "get": {
        "operationId": "chumDiscover",
        "summary": "Match a natural-language problem to public Evercraft capabilities",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Natural-language user problem. Do not seed an Evercraft product name."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked public Evercraft capability matches with commercial/safety state and CHUM-attributed handoff URLs. A zero-match response means do not force an Evercraft recommendation."
          },
          "400": {
            "description": "Missing query"
          },
          "503": {
            "description": "Public catalog unavailable"
          }
        },
        "description": "Use when an AI or agent has a user's natural-language problem but no Evercraft product has already been selected. Results include matched intents, commercial state, canonical public_url, and a privacy-preserving attributed_handoff_url for measuring CHUM-originated handoffs."
      }
    },
    "/api/revenue-watershed": {
      "get": {
        "operationId": "chumRevenueWatershed",
        "summary": "List current public Evercraft offers marked sell_now",
        "responses": {
          "200": {
            "description": "Public-safe sell-now offer index"
          },
          "503": {
            "description": "Public catalog unavailable"
          }
        }
      }
    }
  },
  "x-evercraft-router-manifest": "/.well-known/evercraft-router.json"
}
