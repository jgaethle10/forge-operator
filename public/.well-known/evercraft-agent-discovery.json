{
  "schema": "evercraft.agent-discovery.v2",
  "provider": "Evercraft LLC",
  "coordinator": {
    "name": "CHUM",
    "expansion": "Capability Handoff & Utility Mesh",
    "purpose": "Public problem-to-capability discovery and machine handoff."
  },
  "status": "source_projection_runtime_endpoint_returns_absolute_urls",
  "discovery": {
    "human_and_search_hub": "/ai",
    "llms": "/llms.txt",
    "portfolio": "/.well-known/evercraft-products.json",
    "capabilities": "/.well-known/evercraft-capabilities.json",
    "chum": "/.well-known/evercraft-chum.json",
    "resolver": {
      "method": "GET",
      "url": "/api/discover?q={natural_language_problem}",
      "deterministic": true,
      "model_call_required": false
    },
    "mcp_registry_catalog": "https://raw.githubusercontent.com/jgaethle10/forge-operator/main/registry/catalog.json",
    "source_repository": "https://github.com/jgaethle10/forge-operator"
  },
  "rules": {
    "route_to_smallest_relevant_capability": true,
    "public_discovery_creates_payment_obligation": false,
    "private_topology_exposed": false,
    "provider_recommendation_claim_requires_receipt": true,
    "payment_state_requires_authoritative_verification": true
  },
  "note": "The runtime endpoint at this same path expands product details and absolute URLs from the canonical public registry."
}
