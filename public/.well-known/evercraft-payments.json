{
  "schema": "evercraft.payments-capability.v1",
  "name": "Evercraft Payments",
  "role": "provider-neutral economic operating layer",
  "status": "kernel_v1_source_available",
  "doctrine": {
    "processor_is_adapter_not_authority": true,
    "approved_price_required": true,
    "idempotent_order_required": true,
    "checkout_is_payment_proof": false,
    "authoritative_server_verification_required": true,
    "amount_and_currency_must_match": true,
    "ledger_must_balance": true,
    "entitlements_activate_only_after_verified_settlement": true,
    "fulfillment_unlocks_only_after_verified_settlement": true,
    "split_allocation_does_not_imply_payout": true
  },
  "objects": [
    "evercraft.economic-actor.v1",
    "evercraft.price-quote.v1",
    "evercraft.payment-order.v1",
    "evercraft.payment-attempt.v1",
    "evercraft.ledger-entry.v1",
    "evercraft.revenue-receipt.v1",
    "evercraft.settlement-rail.v1",
    "evercraft.money-route.v1"
  ],
  "planned_api": {
    "quotes": "POST /v1/quotes",
    "orders": "POST /v1/orders",
    "payment_attempts": "POST /v1/payment-attempts",
    "settlement_verification": "POST /v1/payment-attempts/{id}/verify",
    "receipts": "GET /v1/receipts/{id}",
    "ledger": "GET /v1/actors/{id}/ledger",
    "entitlements": "GET /v1/entitlements",
    "fulfillment": "GET /v1/fulfillment/{id}"
  },
  "non_claims": [
    "This source contract does not claim that Evercraft is a bank, card network, money transmitter, or settlement institution.",
    "This source contract does not claim that planned API routes are deployed until separately verified.",
    "A processor checkout session or success redirect is not treated as revenue."
  ],
  "routing": {
    "authority": "Evercraft Payments",
    "processor_role": "replaceable_settlement_adapter",
    "supported_strategies": [
      "lowest_cost",
      "fastest_settlement",
      "preferred_order"
    ],
    "opaque_scoring": false,
    "no_eligible_rail_behavior": "fail_closed"
  }
}
