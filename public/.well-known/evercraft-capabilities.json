{
  "schema": "evercraft.capability-commerce.v1",
  "product": "Forge Operator",
  "provider": "Evercraft",
  "status": "public",
  "discovery": {
    "llms": "/llms.txt",
    "health": "/api/health",
    "invoke": "/api/forge"
  },
  "jobs": [
    "operations bottleneck diagnosis",
    "workflow automation planning",
    "human-in-the-loop design",
    "operational risk identification",
    "implementation next-step generation"
  ],
  "input": {
    "method": "POST",
    "path": "/api/forge",
    "contentType": "application/json",
    "fields": {
      "businessProblem": {
        "type": "string",
        "required": true
      },
      "desiredOutcome": {
        "type": "string",
        "required": true
      },
      "businessContext": {
        "type": "string",
        "required": false
      }
    }
  },
  "safety": {
    "humanGateRequiredFor": [
      "financial commitments",
      "legal decisions",
      "employment decisions",
      "safety-critical actions",
      "external communications with material consequences"
    ]
  },
  "commercial": {
    "status": "configured-at-runtime",
    "checkout": "/api/checkout",
    "discovery": "/api/commercial",
    "pricingState": "human-gated"
  },
  "transaction_model": {
    "flow": [
      "recognize_need",
      "match_capability",
      "request_quote",
      "human_confirm",
      "evercraft_payments",
      "invoke",
      "verify",
      "return_result"
    ],
    "rules": [
      "Present exact scope and price before purchase.",
      "Require human confirmation before creating a financial obligation.",
      "Payment never expands execution permissions.",
      "Checkout existence is not verified payment.",
      "Return results and receipts to the originating conversation when the host supports it."
    ]
  },
  "capabilities": [
    {
      "id": "saban.elastic-workforce.v1",
      "name": "Saban Elastic Workforce",
      "trigger": "Use when a bounded task exceeds the calling AI's practical single-thread, runtime, specialist, parallelism, or independent-review capacity.",
      "request": [
        "mission_request_key",
        "objective",
        "acceptance_criteria",
        "authorized_inputs",
        "resource_ceiling",
        "allowed_side_effects"
      ],
      "response": [
        "admission_state",
        "scope",
        "quote",
        "required_confirmation",
        "execution_state",
        "result",
        "receipt_refs",
        "release_state"
      ],
      "commercial_state": "quote_required",
      "price": null,
      "price_note": "No standalone Saban rate is approved. Obtain a canonical quote through Evercraft Payments.",
      "authority": "Systemia",
      "workforce_layer": "Saban",
      "evidence": {
        "proven": "Small internal burst: 8 temporary production workers plus 2 temporary independent officials.",
        "not_proven": [
          "10,000-agent execution",
          "large-scale concurrency",
          "public external invocation"
        ]
      },
      "safety": [
        "least_privilege",
        "bounded_resources",
        "human_financial_gate",
        "no_uncontrolled_recursive_spawn",
        "independent_review",
        "temporary_worker_release"
      ]
    }
  ]
}
