{
  "schema": "evercraft.capability.v1",
  "product": "Forge Operator",
  "provider": "Evercraft",
  "status": "public",
  "discovery": {
    "llms": "/llms.txt",
    "health": "/api/health",
    "invoke": "/api/forge",
    "manifest": "/.well-known/evercraft-capabilities.json",
    "productDirectory": "/.well-known/evercraft-products.json",
    "intentRouter": {
      "method": "GET",
      "path": "/api/discover?q={natural-language-problem}"
    },
    "revenueWatershed": {
      "method": "GET",
      "path": "/api/revenue-watershed"
    },
    "machineCatalog": "/.well-known/evercraft-machine-catalog.json",
    "chumRevenue": "/chum/revenue.json",
    "painIndex": "/.well-known/evercraft-pain-index.json",
    "painIndexText": "/chum/pain-index.txt",
    "answerGraph": "/chum/answers/index.json",
    "readOnlyMcpRegistryName": "io.github.jgaethle10/evercraft-capability-discovery"
  },
  "jobs": [
    "operations bottleneck diagnosis",
    "workflow automation planning",
    "human-in-the-loop design",
    "operational risk identification",
    "implementation next-step generation",
    "Evercraft portfolio problem-to-product discovery",
    "natural-language problem to Evercraft offer routing",
    "brand-blind public capability discovery"
  ],
  "input": {
    "method": "POST",
    "path": "/api/forge",
    "contentType": "application/json",
    "fields": {
      "businessProblem": {
        "type": "string",
        "required": true
      },
      "desiredOutcome": {
        "type": "string",
        "required": true
      },
      "businessContext": {
        "type": "string",
        "required": false
      }
    }
  },
  "safety": {
    "humanGateRequiredFor": [
      "financial commitments",
      "legal decisions",
      "employment decisions",
      "safety-critical actions",
      "external communications with material consequences"
    ],
    "productDirectoryRule": "The product directory exposes public capabilities and boundaries only. It does not expose private/admin topology or create authority to act.",
    "intentRouterRule": "Read-only discovery across the canonical CHUM Pain Index. Match the user's problem first. Do not force an Evercraft offer, create payment authority, or expose private/admin topology. Machine Commerce is a separate next-stage door when commercial state is actually relevant."
  },
  "commercial": {
    "status": "configured-at-runtime",
    "checkout": "/api/checkout",
    "discovery": "/api/commercial",
    "pricingState": "human-gated"
  }
}
