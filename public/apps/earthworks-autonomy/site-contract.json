{
  "schema": "evercraft.earthworks.site-contract.v0.1",
  "purpose": "Vendor-neutral contract between a site mission, fleet planner, deterministic safety kernel, simulator, and approved equipment adapters.",
  "mission": {
    "required": [
      "mission_id",
      "operating_domain",
      "zones",
      "machine_roster",
      "production_goal"
    ],
    "optional": [
      "design_surface",
      "material_classes",
      "shift_window",
      "weather_constraints",
      "human_work_zones"
    ]
  },
  "machine": {
    "identity": [
      "machine_id",
      "role",
      "adapter",
      "authority_state"
    ],
    "telemetry": [
      "position",
      "heading",
      "speed",
      "state",
      "payload",
      "health",
      "localization_quality",
      "heartbeat_at"
    ],
    "limits": [
      "geofence",
      "max_speed",
      "exclusive_zones",
      "minimum_localization_quality",
      "stop_behavior"
    ]
  },
  "command": {
    "allowed_high_level": [
      "hold",
      "resume",
      "navigate_to_zone",
      "request_load_slot",
      "load",
      "haul",
      "dump",
      "manage_stockpile"
    ],
    "invariant": "Every proposed command is validated by the deterministic safety kernel before an adapter can actuate a physical machine."
  },
  "authority_states": [
    "simulation",
    "shadow",
    "supervised",
    "bounded_physical"
  ],
  "fail_closed_on": [
    "lost_heartbeat",
    "invalid_localization",
    "geofence_violation",
    "speed_envelope_violation",
    "exclusive_zone_conflict",
    "operator_estop"
  ],
  "evidence_boundary": "Publishing this contract does not represent an equipment adapter, machine model, or jobsite as production-approved."
}
