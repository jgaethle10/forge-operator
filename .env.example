# Existing Forge model credential
GEMINI_API_KEY=

# Optional checkout destination
FORGE_CHECKOUT_URL=

# Forge Operator GitHub runtime bridge
# Keep this secret in your deployment environment. Do not commit a real token.
GITHUB_TOKEN=

# Writes remain off unless BOTH this flag is true and the exact repository
# appears in GITHUB_ALLOWED_REPOS.
GITHUB_WRITE_ENABLED=false

# Comma-separated exact owner/repo names.
GITHUB_ALLOWED_REPOS=jgaethle10/forge-operator
