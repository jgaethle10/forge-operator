EVERCRAFT_HOME_HOST=127.0.0.1
EVERCRAFT_HOME_PORT=4310

# Development only. Local mode is forcibly limited to loopback.
EVERCRAFT_HOME_AUTH=local
EVERCRAFT_HOME_OPERATOR=Operator

# Production auth mode:
# EVERCRAFT_HOME_AUTH=passport
# EVERCRAFT_IDENTITY_KEY_ID=home-2026-09
# EVERCRAFT_IDENTITY_SECRET=<current secret managed outside source control>
# EVERCRAFT_IDENTITY_PREVIOUS_KEYS_JSON={"home-2026-08":"<previous secret>"}
# EVERCRAFT_IDENTITY_STATE_DIR=/var/lib/evercraft/identity
# EVERCRAFT_PASSPORT_STATE_DIR=/var/lib/evercraft/passport
# EVERCRAFT_HOME_SESSION_TTL_SECONDS=1800
# EVERCRAFT_HOME_COOKIE_SECURE=true

SYSTEMIA_ORIGIN=http://127.0.0.1:3000
RAVEN_ORIGIN=
YARD_ORIGIN=
NETWORK_ORIGIN=
SOVEREIGN_AI_ORIGIN=

# Optional persisted Yard state for the sanitized executive read view.
EVERCRAFT_YARD_STATE_DIR=

# Optional providers. Never required to boot.
EXTERNAL_AI_ORIGIN=
LEGACY_APP_ORIGIN=


# Owned Raven/Nexus read-only team-review bridge.
# Runtime configuration only. Never commit real tokens.
RAVEN_NEXUS_WORK_URL=http://127.0.0.1:4321
RAVEN_NEXUS_WORK_TOKEN_FILE=/var/lib/evercraft/raven/control-token
EVERCRAFT_RAVEN_RECEIPT_DIR=/var/lib/evercraft/raven-receipts

# Optional, owner-controlled private canonical Evercraft Payments readback.
# Do not point at public checkout, Stripe returns, or a test provider.
# Default is absent: the dashboard displays UNKNOWN, not zero.
# HTTPS origin must be a trusted owned domain, with no query or custom port.
# EVERCRAFT_HOME_PAYMENTS_READBACK_URL=https://fabric.systemiacommandcenters.com/internal/payments/executive-readback
# Absolute root-owned mode 0600 bearer token file, never commit its bytes.
# EVERCRAFT_HOME_PAYMENTS_READBACK_TOKEN_FILE=/var/lib/evercraft/payments/home-readback-token
# Home Passport subject requires separate scope: home.payments.read

# Optional local source vault for private Executive Floor continuity readback.
# Absolute mode 0700 owner-controlled directory on the owned Home machine.
# MUST be outside the source checkout; never a GitHub or cloud storage URL.
# This status view only reports local manifest presence. Restore verification is separate.
EVERCRAFT_CONTINUITY_VAULT_DIR=
