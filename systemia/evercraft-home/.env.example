EVERCRAFT_HOME_HOST=127.0.0.1
EVERCRAFT_HOME_PORT=4310

# Development only. Local mode is forcibly limited to loopback.
EVERCRAFT_HOME_AUTH=local
EVERCRAFT_HOME_OPERATOR=Operator

# Production auth mode:
# EVERCRAFT_HOME_AUTH=passport
# EVERCRAFT_IDENTITY_SECRET=<secret managed outside source control>
# EVERCRAFT_IDENTITY_STATE_DIR=/var/lib/evercraft/identity
# EVERCRAFT_PASSPORT_STATE_DIR=/var/lib/evercraft/passport
# EVERCRAFT_HOME_SESSION_TTL_SECONDS=1800
# EVERCRAFT_HOME_COOKIE_SECURE=true

SYSTEMIA_ORIGIN=http://127.0.0.1:3000
RAVEN_ORIGIN=
YARD_ORIGIN=
NETWORK_ORIGIN=
SOVEREIGN_AI_ORIGIN=

# Optional persisted Yard state for the sanitized executive read view.
EVERCRAFT_YARD_STATE_DIR=

# Optional providers. Never required to boot.
EXTERNAL_AI_ORIGIN=
LEGACY_APP_ORIGIN=
