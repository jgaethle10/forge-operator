{
  "schema": "evercraft.compute.workload.v1",
  "workload_id": "systemia-core-supervisor",
  "owner": "Evercraft",
  "control_plane": "Systemia",
  "deployment_surface": "Yard Operator",
  "runtime_fabric": "Evercraft Compute",
  "capacity_protocol": "evercraft.capacity.v1",
  "workload_class": "systemia.core-supervisor.v1",
  "service_type": "resident",
  "provider_policy": {
    "named_cloud_dependency": false,
    "allocation": "legitimately_granted_runtime_capacity",
    "silent_fallback": false
  },
  "state_boundary": {
    "public_code_root": "forge-operator reviewed runtime",
    "private_state_root": "Evercraft Compute admitted root",
    "yard_state": "colocated private state for v1",
    "source_tree_writable": false
  },
  "supervised_workflows": [
    "portfolio-sentinel",
    "eps-social-continuity",
    "legacy-rescue-opportunity-watch",
    "node001-field-certification-watch",
    "remote-device-trust-watch",
    "kaidance-mission-publisher",
    "public-edge-controller",
    "public-edge-activation-watch"
  ],
  "security": {
    "lease_required": true,
    "workload_allowlist": true,
    "private_paths_not_in_deployment_receipt": true,
    "allocator_token_not_in_child_environment": true,
    "child_stdout_stderr_not_persisted": true,
    "filesystem_state_root_bounded": true,
    "public_edge_allocator_secret_in_config": false,
    "public_edge_allocator_secret_file_reference_only": false,
    "public_edge_authority_source": "private Yard lease authority or broker-derived control grant, consumed in memory only",
    "public_edge_authority_persisted_by_watch": false,
    "public_edge_field_enrollment_required_for_production": true,
    "public_edge_same_device_attestation_required": true
  },
  "acceptance": [
    "capacity_offer_verified",
    "lease_granted",
    "core_supervisor_started",
    "all_supervised_services_not_failed_or_held",
    "yard_health_verified",
    "deployment_receipt_bound",
    "private_workspace_writable",
    "source_tree_not_used_for_runtime_state",
    "clean_stop_verified",
    "public_edge_controller_restart_budget_enforced",
    "public_edge_activation_cycle_runs_every_300_seconds",
    "public_edge_controller_waits_resident_without_restart_churn",
    "public_edge_private_workspace_verified",
    "public_edge_release_ref_bound_to_yard_release",
    "public_edge_allocator_authority_not_in_child_environment",
    "public_edge_allocator_authority_not_persisted_by_watch",
    "unconfigured_or_unavailable_public_edge_holds_cycle_without_holding_core",
    "eps_social_continuity_optional_until_private_clip_binding_present",
    "eps_social_continuity_requires_provider_visible_verification_before_success"
  ]
}
