{
  "schema": "evercraft.systemia.resident-supervisor-config.v1",
  "services": [
    {
      "service_key": "portfolio-sentinel",
      "mode": "cycle",
      "manifest": "systemia/organism/portfolio-sentinel.workflow.json",
      "executable": "systemia/organism/portfolio-sentinel-runner.mjs",
      "cadence_seconds": 300,
      "static_args": [
        "--max-urls",
        "24"
      ],
      "optional_env_args": {
        "--github-owner": "PORTFOLIO_SENTINEL_GITHUB_OWNER",
        "--github-repo": "GITHUB_REPOSITORY",
        "--out": "SYSTEMIA_PORTFOLIO_SENTINEL_OUT_DIR"
      }
    },
    {
      "service_key": "legacy-rescue-opportunity-watch",
      "mode": "cycle",
      "manifest": "systemia/organism/legacy-rescue-watch.workflow.json",
      "executable": "systemia/organism/legacy-rescue-watch-runner.mjs",
      "cadence_seconds": 300,
      "optional_env_args": {
        "--signals": "SYSTEMIA_LEGACY_RESCUE_SIGNALS_FILE",
        "--out": "SYSTEMIA_LEGACY_RESCUE_OUT_DIR"
      }
    },
    {
      "service_key": "node001-field-certification-watch",
      "mode": "cycle",
      "manifest": "systemia/organism/node001-field-certification.workflow.json",
      "executable": "systemia/organism/node001-field-certification-runner.mjs",
      "cadence_seconds": 300,
      "optional_env_args": {
        "--dir": "SYSTEMIA_NODE001_FIELD_DIR",
        "--out": "SYSTEMIA_NODE001_STATUS_DIR"
      }
    },
    {
      "service_key": "remote-device-trust-watch",
      "mode": "cycle",
      "manifest": "systemia/organism/pending-device-trust-watch.workflow.json",
      "executable": "systemia/organism/pending-device-trust-watch-runner.mjs",
      "cadence_seconds": 300,
      "env_args": {
        "--yard-state": "SYSTEMIA_YARD_STATE_DIR"
      },
      "optional_env_args": {
        "--broker-deployment": "SYSTEMIA_REMOTE_BROKER_DEPLOYMENT_ID",
        "--out": "SYSTEMIA_REMOTE_DEVICE_TRUST_WATCH_OUT_DIR"
      }
    },
    {
      "service_key": "kaidance-mission-publisher",
      "mode": "resident",
      "manifest": "systemia/organism/mission-publisher.workflow.json",
      "executable": "systemia/organism/mission-publisher-runner.mjs",
      "static_args": [
        "--watch"
      ],
      "env_args": {
        "--yard-state": "SYSTEMIA_YARD_STATE_DIR",
        "--deployment-id": "KAIDANCE_DEPLOYMENT_ID"
      },
      "optional_env_args": {
        "--allowed-root": "SYSTEMIA_WORKSPACE_ROOT",
        "--ledger": "SYSTEMIA_MISSION_PUBLISHER_LEDGER",
        "--config": "SYSTEMIA_MISSION_SOURCES_CONFIG"
      },
      "max_restarts_per_hour": 12,
      "restart_backoff_ms": 5000
    },
    {
      "service_key": "public-edge-controller",
      "mode": "resident",
      "manifest": "systemia/organism/public-edge-controller.workflow.json",
      "executable": "systemia/organism/public-edge-controller-runner.mjs",
      "optional_when_unconfigured": true,
      "env_args": {
        "--yard-state": "SYSTEMIA_YARD_STATE_DIR",
        "--controller-state": "SYSTEMIA_PUBLIC_EDGE_CONTROLLER_STATE_DIR",
        "--capacity-endpoint": "EVERCRAFT_PUBLIC_EDGE_CAPACITY_ENDPOINT",
        "--release-ref": "EVERCRAFT_PUBLIC_EDGE_RELEASE_REF",
        "--base-domain": "EVERCRAFT_PUBLIC_EDGE_BASE_DOMAIN",
        "--tls-key-path": "EVERCRAFT_PUBLIC_EDGE_TLS_KEY_PATH",
        "--tls-cert-path": "EVERCRAFT_PUBLIC_EDGE_TLS_CERT_PATH",
        "--allocator-token-file": "EVERCRAFT_PUBLIC_EDGE_ALLOCATOR_TOKEN_FILE"
      },
      "optional_env_args": {
        "--requested-hostname": "EVERCRAFT_PUBLIC_EDGE_SPECIALIST_HOSTNAME",
        "--gateway-url": "EVERCRAFT_MACHINE_COMMERCE_GATEWAY_URL",
        "--public-port": "EVERCRAFT_PUBLIC_EDGE_PORT",
        "--lease-ttl-ms": "EVERCRAFT_PUBLIC_EDGE_LEASE_TTL_MS",
        "--renew-every-ms": "EVERCRAFT_PUBLIC_EDGE_RENEW_EVERY_MS",
        "--interval-ms": "EVERCRAFT_PUBLIC_EDGE_CONTROLLER_INTERVAL_MS"
      },
      "max_restarts_per_hour": 12,
      "restart_backoff_ms": 5000
    }
  ]
}
