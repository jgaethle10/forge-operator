{
  "schema": "evercraft.systemia.resident-supervisor-config.v1",
  "services": [
    {
      "service_key": "legacy-rescue-opportunity-watch",
      "mode": "cycle",
      "manifest": "systemia/organism/legacy-rescue-watch.workflow.json",
      "executable": "systemia/organism/legacy-rescue-watch-runner.mjs",
      "cadence_seconds": 300,
      "optional_env_args": {
        "--signals": "SYSTEMIA_LEGACY_RESCUE_SIGNALS_FILE",
        "--out": "SYSTEMIA_LEGACY_RESCUE_OUT_DIR"
      }
    },
    {
      "service_key": "node001-field-certification-watch",
      "mode": "cycle",
      "manifest": "systemia/organism/node001-field-certification.workflow.json",
      "executable": "systemia/organism/node001-field-certification-runner.mjs",
      "cadence_seconds": 300,
      "optional_env_args": {
        "--dir": "SYSTEMIA_NODE001_FIELD_DIR",
        "--out": "SYSTEMIA_NODE001_STATUS_DIR"
      }
    },
    {
      "service_key": "remote-device-trust-watch",
      "mode": "cycle",
      "manifest": "systemia/organism/pending-device-trust-watch.workflow.json",
      "executable": "systemia/organism/pending-device-trust-watch-runner.mjs",
      "cadence_seconds": 300,
      "env_args": {
        "--yard-state": "SYSTEMIA_YARD_STATE_DIR"
      },
      "optional_env_args": {
        "--broker-deployment": "SYSTEMIA_REMOTE_BROKER_DEPLOYMENT_ID",
        "--out": "SYSTEMIA_REMOTE_DEVICE_TRUST_WATCH_OUT_DIR"
      }
    },
    {
      "service_key": "kaidance-mission-publisher",
      "mode": "resident",
      "manifest": "systemia/organism/mission-publisher.workflow.json",
      "executable": "systemia/organism/mission-publisher-runner.mjs",
      "static_args": [
        "--watch"
      ],
      "env_args": {
        "--yard-state": "SYSTEMIA_YARD_STATE_DIR",
        "--deployment-id": "KAIDANCE_DEPLOYMENT_ID"
      },
      "optional_env_args": {
        "--allowed-root": "SYSTEMIA_WORKSPACE_ROOT",
        "--ledger": "SYSTEMIA_MISSION_PUBLISHER_LEDGER",
        "--config": "SYSTEMIA_MISSION_SOURCES_CONFIG"
      },
      "max_restarts_per_hour": 12,
      "restart_backoff_ms": 5000
    }
  ]
}
