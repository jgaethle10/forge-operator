{
  "schema": "evercraft.evermail.mailbox-intent.v2",
  "tenant": "rivet",
  "service_id": "rivet-mail",
  "logical_uri": "evercraft://mail/rivet",
  "internal_namespace": "rivet.evercraft",
  "public_identity_policy": {
    "mode": "standalone_rivet_brand",
    "public_domain": null,
    "public_domain_env": "RIVET_PUBLIC_MAIL_DOMAIN",
    "require_explicit_domain_approval": true,
    "require_public_delegation_receipt": true,
    "no_fallback_public_domain": true,
    "forbidden_public_domain_tokens": [
      "evercraft",
      "systemia",
      "base44"
    ],
    "rule": "Public customer-facing email exposes RIVET only. Evercraft remains the internal authority and runtime."
  },
  "provider_policy": {
    "preferred": "evercraft-owned",
    "fallback": "none",
    "third_party_mail_relay": false,
    "new_spend_allowed": false
  },
  "mailboxes": [
    {
      "local_part": "paola",
      "internal_identity": "evercraft://mail/rivet/paola",
      "public_address_template": "paola@${RIVET_PUBLIC_MAIL_DOMAIN}",
      "purpose": "RIVET sales, customer communication and invoice delivery",
      "display_name": "Paola | RIVET",
      "send": true,
      "receive": true
    },
    {
      "local_part": "daryl",
      "internal_identity": "evercraft://mail/rivet/daryl",
      "public_address_template": "daryl@${RIVET_PUBLIC_MAIL_DOMAIN}",
      "purpose": "RIVET sales and business development",
      "display_name": "Daryl | RIVET",
      "send": true,
      "receive": true
    },
    {
      "local_part": "jess",
      "internal_identity": "evercraft://mail/rivet/jess",
      "public_address_template": "jess@${RIVET_PUBLIC_MAIL_DOMAIN}",
      "purpose": "RIVET team communication",
      "display_name": "Jess | RIVET",
      "send": true,
      "receive": true
    },
    {
      "local_part": "jesse",
      "internal_identity": "evercraft://mail/rivet/jesse",
      "public_address_template": "jesse@${RIVET_PUBLIC_MAIL_DOMAIN}",
      "purpose": "RIVET founder and product communication",
      "display_name": "Jesse | RIVET",
      "send": true,
      "receive": true
    },
    {
      "local_part": "invoices",
      "internal_identity": "evercraft://mail/rivet/invoices",
      "public_address_template": "invoices@${RIVET_PUBLIC_MAIL_DOMAIN}",
      "purpose": "customer invoices and invoice replies",
      "display_name": "RIVET",
      "send": true,
      "receive": true
    },
    {
      "local_part": "billing",
      "internal_identity": "evercraft://mail/rivet/billing",
      "public_address_template": "billing@${RIVET_PUBLIC_MAIL_DOMAIN}",
      "purpose": "billing and accounts receivable",
      "display_name": "RIVET Billing",
      "send": true,
      "receive": true
    },
    {
      "local_part": "hello",
      "internal_identity": "evercraft://mail/rivet/hello",
      "public_address_template": "hello@${RIVET_PUBLIC_MAIL_DOMAIN}",
      "purpose": "general customer communication",
      "display_name": "RIVET",
      "send": true,
      "receive": true
    },
    {
      "local_part": "ops",
      "internal_identity": "evercraft://mail/rivet/ops",
      "public_address_template": "ops@${RIVET_PUBLIC_MAIL_DOMAIN}",
      "purpose": "operations and fulfillment",
      "display_name": "RIVET Operations",
      "send": true,
      "receive": true
    },
    {
      "local_part": "postmaster",
      "internal_identity": "evercraft://mail/rivet/postmaster",
      "public_address_template": "postmaster@${RIVET_PUBLIC_MAIL_DOMAIN}",
      "purpose": "required mail administration role",
      "display_name": "RIVET Postmaster",
      "send": false,
      "receive": true
    },
    {
      "local_part": "abuse",
      "internal_identity": "evercraft://mail/rivet/abuse",
