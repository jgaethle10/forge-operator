    },
    {
      "local_part": "billing",
      "purpose": "billing and accounts receivable",
      "display_name": "RIVET Billing",
      "send": true,
      "receive": true
    },
    {
      "local_part": "hello",
      "purpose": "general customer communication",
      "display_name": "RIVET",
      "send": true,
      "receive": true
    },
    {
      "local_part": "ops",
      "purpose": "operations and fulfillment",
      "display_name": "RIVET Operations",
      "send": true,
      "receive": true
    },
    {
      "local_part": "postmaster",
      "purpose": "required mail administration role",
      "display_name": "RIVET Postmaster",
