      "display_name": "RIVET Abuse",
      "send": false,
      "receive": true
    },
    {
      "local_part": "dmarc",
      "internal_identity": "evercraft://mail/rivet/dmarc",
      "public_address_template": "dmarc@${RIVET_PUBLIC_MAIL_DOMAIN}",
      "purpose": "DMARC aggregate and forensic reports",
      "display_name": "RIVET DMARC",
      "send": false,
      "receive": true
    },
    {
      "local_part": "tlsrpt",
      "internal_identity": "evercraft://mail/rivet/tlsrpt",
      "public_address_template": "tlsrpt@${RIVET_PUBLIC_MAIL_DOMAIN}",
      "purpose": "SMTP TLS reporting",
      "display_name": "RIVET TLS Reporting",
      "send": false,
      "receive": true
    }
  ],
  "sender_policy": {
    "default_invoice_sender": "invoices@${RIVET_PUBLIC_MAIL_DOMAIN}",
    "personal_sender_allowed": true,
    "reply_to_may_be_personal_staff_mailbox": true,
    "customer_visible_brand": "RIVET"
  },
  "signing": {
    "dkim_required": true,
    "dkim_selector": "rivet1",
    "spf_required": true,
    "dmarc_required": true,
    "mta_sts_required": true,
    "tls_reporting_required": true
  },
  "promotion": {
    "public_domain_must_be_selected": true,
    "public_domain_must_not_leak_parent_brand": true,
    "live_send_requires_evermail_public_canary_green": true,
    "live_receive_requires_public_mx_green": true,
    "mailbox_auth_receipt_required": true,
    "backup_restore_receipt_required_before_staff_mailbox_promotion": true
  },
  "notes": [
    "Permanent identities are Evercraft fabric URIs; customer-facing addresses are RIVET-only aliases on an explicitly approved standalone RIVET domain.",
    "rivet.evercraft is an internal namespace only and must never be advertised as a public Internet email domain.",
    "There is no systemiacommandcenters.com, evercraft.*, or Base44 fallback for public RIVET email.",
    "Do not claim these mailboxes are publicly live until the Evermail canary proves MX, SPF, DKIM, DMARC, reverse DNS, SMTP STARTTLS and trusted TLS."
  ]
}
