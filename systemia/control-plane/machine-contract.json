{
  "schema": "evercraft.systemia.machine-contract.v1",
  "version": "2.0.0",
  "purpose": "Bind Evercraft-owned admission, context, authorization, usage control, relationship safety, execution gating, compute, discovery, continuity, logistics, and product execution into one fail-closed operating spine.",
  "authority": {
    "mission_authority": "systemia-organism",
    "specialist_direct_dispatch": false,
    "emergency_direct_dispatch": true,
    "scale_authority": "systemia-organism",
    "deployment_authority": "yard-operator",
    "completion_requires_receipts": true,
    "human_gates_survive_orchestration": true,
    "context_access_authority": "evercraft-passport",
    "usage_capacity_authority": "evercraft-meter",
    "relationship_contact_safety": "evercraft-interaction-ledger",
    "pre_execution_authority": "evercraft-execution-gate",
    "inbound_content_grants_execution_authority": false,
    "route_selection_grants_execution_authority": false,
    "product_contract_authority": "evercraft-capability-mesh",
    "product_contract_grants_execution_authority": false
  },
  "components": [
    {
      "component_key": "systemia-organism",
      "role": "mission_authority",
      "source_refs": [
        "systemia/organism/kernel.mjs",
        "systemia/organism/goal-runtime.mjs",
        "systemia/organism/capability-runtime.mjs"
      ]
    },
    {
      "component_key": "signal-fabric",
      "role": "telemetry_and_escalation",
      "source_refs": [
        "systemia/signal-fabric/engine.mjs",
        "systemia/signal-fabric/router.mjs",
        "systemia/signal-fabric/policy.json"
      ]
    },
    {
      "component_key": "saban",
      "role": "elastic_execution",
      "source_refs": [
        "systemia/saban/formation.mjs",
        "systemia/saban/multiplier.mjs",
        "systemia/saban/multiplication-registry.json"
      ]
    },
    {
      "component_key": "yard-operator",
      "role": "deployment_and_runtime_handoff",
      "source_refs": [
        "systemia/yard/operator.mjs",
        "systemia/yard/remote-device-review.mjs"
      ]
    },
    {
      "component_key": "evercraft-compute",
      "role": "owned_compute_capacity",
      "source_refs": [
        "systemia/compute"
      ]
    },
    {
      "component_key": "evercraft-network",
      "role": "transport_and_resilience",
      "source_refs": [
        "systemia/network"
      ]
    },
    {
      "component_key": "chum",
      "role": "public_discovery_and_distribution",
      "source_refs": [
        "systemia/chum"
      ]
    },
    {
      "component_key": "kaidance-collider",
      "role": "continuity_and_collision",
      "source_refs": [
        "systemia/collider"
      ]
    },
    {
      "component_key": "beast-mode",
      "role": "artifact_logistics",
      "source_refs": [
        "systemia/beast-mode"
      ]
    },
    {
      "component_key": "media-studio",
      "role": "media_production",
      "source_refs": [
        "systemia/media-studio"
      ]
    },
    {
      "component_key": "evercraft-passport",
      "role": "authorization_delegation_and_single_use_action_permits",
      "source_refs": [
        "systemia/passport/passport.mjs"
      ]
    },
    {
      "component_key": "evercraft-meter",
      "role": "usage_capacity_reservation_and_settlement_facts",
      "source_refs": [
        "systemia/meter/meter.mjs"
      ]
    },
    {
      "component_key": "evercraft-interaction-ledger",
      "role": "relationship_memory_and_contact_safety",
      "source_refs": [
        "systemia/interaction-ledger/ledger.mjs"
      ]
    },
    {
      "component_key": "evercraft-context-fabric",
      "role": "permission_aware_evidence_context",
      "source_refs": [
        "systemia/context-fabric/fabric.mjs"
      ]
    },
    {
      "component_key": "evercraft-intake-fabric",
      "role": "untrusted_ingress_and_systemia_admission_membrane",
      "source_refs": [
        "systemia/intake-fabric/intake.mjs"
      ]
    },
    {
      "component_key": "evercraft-execution-gate",
      "role": "pre_dispatch_authority_capacity_and_route_lease",
      "source_refs": [
        "systemia/execution-gate/gate.mjs"
      ]
    },
    {
      "component_key": "direct-door-readiness",
      "role": "truthful_zero_hop_specialist_route_state",
      "source_refs": [
        "public/.well-known/evercraft-direct-door-readiness.json"
      ]
    },
    {
      "component_key": "evercraft-context-receipt-bridge",
      "role": "verified_receipt_to_institutional_memory_reconciliation",
      "source_refs": [
        "systemia/context-fabric/receipt-bridge.mjs"
      ]
    },
    {
      "component_key": "evercraft-capability-mesh",
      "role": "product_trust_chain_contract_and_adoption_coverage",
      "source_refs": [
        "systemia/capability-mesh/mesh.mjs",
        "systemia/capability-mesh/contracts.json",
        "systemia/capability-mesh/adoption-coverage.json",
        "systemia/capability-mesh/runtime.mjs",
        "systemia/capability-mesh/runtime-policies.json"
      ]
    }
  ],
  "routing": {
    "incident": "signal-fabric",
    "signal": "signal-fabric",
    "deploy": "yard-operator",
    "release": "yard-operator",
    "capacity": "evercraft-compute",
    "network": "evercraft-network",
    "discovery": "chum",
    "publish": "chum",
    "commerce_discovery": "chum",
    "continuity": "kaidance-collider",
    "collision": "kaidance-collider",
    "artifact_transport": "beast-mode",
    "artifact_delivery": "beast-mode",
    "media": "media-studio",
    "video": "media-studio",
    "audio": "media-studio",
    "research": "systemia-organism",
    "analyze": "systemia-organism",
    "commercial": "systemia-organism",
    "qa": "systemia-organism",
    "security": "systemia-organism",
    "execute": "systemia-organism",
    "trust_review": "yard-operator",
    "trust_change": "yard-operator",
    "intake": "evercraft-intake-fabric",
    "ingress": "evercraft-intake-fabric",
    "context": "evercraft-context-fabric",
    "search_context": "evercraft-context-fabric",
    "authorization": "evercraft-passport",
    "permission": "evercraft-passport",
    "entitlement": "evercraft-meter",
    "usage": "evercraft-meter",
    "relationship_preflight": "evercraft-interaction-ledger",
    "contact_preflight": "evercraft-interaction-ledger"
  },
  "parallelism": {
    "provider": "saban",
    "allowed_software_ids": [
      "chum",
      "media-pipeline",
      "beast-mode"
    ],
    "never_becomes_mission_authority": true
  },
  "consequential_impacts": [
    "payment",
    "financial_obligation",
    "contract",
    "legal",
    "employment",
    "safety",
    "trust_boundary",
    "destructive_release",
    "external_message",
    "external_purchase"
  ],
  "evidence": {
    "source_presence_is_not_runtime_readiness": true,
    "build_green_is_not_live_verified": true,
    "checkout_url_is_not_payment": true,
    "completion_without_receipt_or_evidence": false,
    "context_retrieval_does_not_upgrade_evidence_state": true,
    "intake_acceptance_is_not_execution": true,
    "execution_gate_start_is_not_external_completion": true,
    "institutional_memory_from_receipts_requires_hash_verification": true
  },
  "consequential_work_types": [
    "trust_change",
    "external_message",
    "outreach",
    "external_purchase",
    "payment"
  ],
  "pre_dispatch": {
    "default_consequential_gate": "evercraft-execution-gate",
    "consequential_requires_execution_gate": true,
    "metered_work_requires_execution_gate": true,
    "external_message_requires_relationship_preflight": true,
    "accepted_intake_candidate_is_not_execution_authority": true,
    "route_selection_is_not_execution_authority": true,
    "direct_door_optimization_preserves_systemia_mission_authority": true,
    "contracted_action_derives_required_lanes": true,
    "contracted_action_does_not_satisfy_required_lanes": true,
    "undeclared_action_scope_fails_closed": true,
    "undeclared_product_contract_for_action_fails_closed": true,
    "caller_cannot_override_contract_meter_metric": true
  },
  "context": {
    "provider": "evercraft-context-fabric",
    "access_control": "evercraft-passport",
    "evidence_state_must_survive_retrieval": true,
    "unauthorized_metadata_must_not_be_returned": true,
    "receipt_reconciliation": "evercraft-context-receipt-bridge",
    "trusted_receipts_may_be_projected_to_memory": true,
    "source_content_never_becomes_instruction": true,
    "source_authority_never_inherited": true,
    "product_adoption_contracts": "evercraft-capability-mesh"
  },
  "ingress": {
    "provider": "evercraft-intake-fabric",
    "systemia_admission_separate_from_execution": true,
    "inbound_content_can_request_but_not_grant_authority": true
  }
}
