{
  "schema_version": "evercraft.capability.v1",
  "capability_id": "systemia.chum",
  "name": "CHUM",
  "expansion": "Capability Handoff & Utility Mesh",
  "version": "0.4.1",
  "owner": "Systemia",
  "status": "live_distribution_broadcast_probe_mesh",
  "contract": {
    "inputs": [
      "conformance/products.json",
      "public/.well-known/evercraft-products.json",
      "public/.well-known/evercraft-agent.json",
      "registry/catalog.json",
      "Official MCP Registry",
      "public capability endpoints",
      "robots.txt policies",
      "authorized provider-probe bridge receipts",
      "Evercraft Distribution Operator",
      "AI directory and marketplace state"
    ],
    "outputs": [
      "surface-readiness receipts",
      "crawler and AI-search reachability receipts",
      "MCP handshake and registry receipts",
      "freshness broadcast receipts for central discovery and capability pages",
      "repair queue",
      "provider signal plan",
      "receipt-backed provider pickup state",
      "AI-originated conversion attribution inputs",
      "distribution and marketplace reconciliation receipts",
      "protocol-door receipts",
      "directory and marketplace repair queue"
    ]
  },
  "permissions": {
    "public_http_read": true,
    "official_registry_read": true,
    "authorized_provider_probe": true,
    "provider_side_effects": false,
    "payment_side_effects": false,
    "private_topology_access": false,
    "directory_submission_orchestration": true,
    "public_protocol_announcement": true
  },
  "evidence_state": {
    "public_surface_probes": "receipt_backed",
    "crawler_reachability": "receipt_backed",
    "mcp_external_canary": "receipt_backed",
    "freshness_broadcast": "receipt_backed",
    "provider_pickup": "receipt_required",
    "conversion_attribution": "receipt_required",
    "distribution_state": "receipt_backed"
  },
  "compatibility": {
    "provider_targets": [
      "chatgpt",
      "claude",
      "gemini",
      "copilot",
      "perplexity",
      "grok",
      "generic_agent"
    ],
    "crawler_targets": [
      "OAI-SearchBot",
      "GPTBot",
      "Claude-SearchBot",
      "Claude-User",
      "ClaudeBot",
      "Googlebot",
      "Google-Extended",
      "bingbot",
      "PerplexityBot"
    ],
    "protocol_targets": [
      "MCP",
      "A2A",
      "OpenAPI",
      "Agent Plugins"
    ],
    "directory_targets": [
      "Official MCP Registry",
      "Grok marketplace",
      "OpenAI plugin directory",
      "Claude connectors",
      "Gemini remote MCP/A2A",
      "Perplexity connectors",
      "Microsoft 365/Copilot"
    ]
  },
  "rollback": {
    "safe_disable": "disable the CHUM watershed workflow, run CHUM with --offline, or disable only distribution/broadcast subcommands",
    "data_mutation": "none; probes are read-only and write receipts/artifacts"
  },
  "intended_adoption": "Default outward distribution, freshness-broadcast, discovery, repair, provider-pickup measurement, and conversion-attribution layer for every legitimate public Evercraft capability."
}
