{
  "schema_version": "evercraft.capability.v1",
  "capability_id": "systemia.chum",
  "name": "CHUM",
  "expansion": "Capability Handoff & Utility Mesh",
  "version": "0.8.0",
  "owner": "Systemia",
  "status": "live_in_forge_operator",
  "contract": {
    "inputs": [
      "conformance/products.json",
      "public/.well-known/evercraft-products.json",
      "public/.well-known/evercraft-agent.json",
      "registry/catalog.json",
      "Official MCP Registry",
      "public capability endpoints",
      "robots.txt policies",
      "authorized provider-probe bridge receipts",
      "public/.well-known/evercraft-machine-catalog.json",
      "signed CHUM referral tokens",
      "trusted payment verification receipts",
      "public/.well-known/evercraft-pain-index.json",
      "public/chum/answers/index.json",
      "shared concept-aware intent language fabric",
      "receipt-backed provider miss repair queue",
      "agent-to-agent commercial proposals",
      "optional signed delegated deal authority envelope"
    ],
    "outputs": [
      "plain-text LLM routing index",
      "brand-blind pain-first routing index",
      "surface-readiness receipts",
      "crawler and AI-search reachability receipts",
      "MCP handshake and registry receipts",
      "freshness broadcast receipts for central discovery and capability pages",
      "repair queue",
      "provider signal plan",
      "receipt-backed provider pickup state",
      "AI-originated conversion attribution inputs",
      "privacy-minimized CHUM handoff receipts",
      "authoritatively verified payment attribution receipts",
      "exact natural-language answer graph",
      "read-only Official MCP Registry discovery front door",
      "full-portfolio live pain matcher",
      "crawlable CHUM problem-entry page",
      "concept-aware brand-blind routing receipts",
      "routing confidence and runner-up margin",
      "Saban-multipliable receipt-backed discovery repairs",
      "non-binding machine counterproposals",
      "deal authority receipts and human-exception gates"
    ]
  },
  "permissions": {
    "public_http_read": true,
    "official_registry_read": true,
    "authorized_provider_probe": true,
    "provider_side_effects": false,
    "payment_side_effects": false,
    "private_topology_access": false,
    "public_referral_issue": true,
    "public_payment_claims": false,
    "trusted_payment_receipt_ingest": true,
    "bounded_commercial_negotiation_response": true,
    "binding_contract_acceptance": false,
    "autonomous_price_concessions": false,
    "signed_delegated_price_concessions": true
  },
  "evidence_state": {
    "public_surface_probes": "receipt_backed",
    "crawler_reachability": "receipt_backed",
    "mcp_external_canary": "receipt_backed",
    "freshness_broadcast": "receipt_backed",
    "provider_pickup": "receipt_required",
    "conversion_attribution": "signed_referral_plus_receipt_backed",
    "pain_index": "deterministic_build_and_brand_blind_tests",
    "revenue_attribution": "authoritative_payment_verification_required",
    "provider_identity_in_referral": "caller_asserted_unless_separately_receipted",
    "expanded_agent_reachability": "receipt_backed",
    "answer_graph": "deterministic_build_from_canonical_pain_index",
    "read_only_mcp_registry": "published_receipt_required_for_registry_claim",
    "intent_routing": "deterministic_concept_aware_scoring_with_brand_blind_regressions",
    "discovery_repairs": "provider_receipt_hashed_and_saban_work_item_backed",
    "deal_desk": "deterministic_nonbinding_counterproposal_with_signed_authority_verification"
  },
  "compatibility": {
    "provider_targets": [
      "chatgpt",
      "claude",
      "gemini",
      "copilot",
      "perplexity",
      "grok",
      "generic_agent",
      "apple_search",
      "apple_intelligence",
      "google_vertex_agents",
      "gemini_notebook"
    ],
    "crawler_targets": [
      "OAI-SearchBot",
      "GPTBot",
      "Claude-SearchBot",
      "Claude-User",
      "ClaudeBot",
      "Googlebot",
      "Google-Extended",
      "bingbot",
      "PerplexityBot",
      "Applebot",
      "Applebot-Extended",
      "Google-CloudVertexBot",
      "Google-Agent",
      "Google-GeminiNotebook"
    ],
    "public_front_doors": {
      "pain_index": "/.well-known/evercraft-pain-index.json",
      "pain_index_text": "/chum/pain-index.txt",
      "answer_graph": "/chum/answers/index.json",
      "live_router": "GET /api/discover?q={natural-language-problem}",
      "read_only_mcp_registry_name": "io.github.jgaethle10/evercraft-capability-discovery",
      "machine_commerce_registry_name": "io.github.jgaethle10/evercraft-machine-commerce",
      "deal_desk": "POST /api/chum/negotiate"
    },
    "intent_engine": {
      "revision": "concept-fabric-v2",
      "behavior": [
        "token and lightweight morphology matching",
        "concept alias matching",
        "phrase and bigram support",
        "top-three intent contribution cap to prevent metadata verbosity bias",
        "close-match clarification before conversion"
      ]
    }
  },
  "rollback": {
    "safe_disable": "disable the CHUM watershed workflow or run CHUM with --offline",
    "data_mutation": "CHUM may return non-binding Deal Desk proposals but does not execute contracts or payments; disable the endpoint or remove CHUM_DEAL_AUTHORITY_SECRET to eliminate delegated price concessions."
  },
  "intended_adoption": "Default distribution, freshness-broadcast and discovery feedback layer for every legitimate public Evercraft capability. A cold AI should be able to start from ordinary problem-language, traverse read-only discovery, and reach the smallest truthful capability without prior Evercraft brand knowledge."
}
