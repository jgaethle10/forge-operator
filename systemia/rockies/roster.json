{
  "schema": "evercraft.rockies.topology.v1",
  "version": "1.0.0",
  "doctrine": {
    "role": "Public-source observation specialists feeding Systemia shared context.",
    "stored_is_integrated": false,
    "default_output": "evercraft.context.observation.v1",
    "direct_human_notification": false,
    "direct_external_action": false,
    "independent_source_family_target": 2,
    "baseline_policy": "Learn normal cadence before promoting deviation.",
    "surge_policy": "Increase logical Rockies when a context node crosses anomaly, freshness, or corroboration thresholds."
  },
  "scaling": {
    "current_reference_agents": 65,
    "target_baseline_agents": 99,
    "max_surge_agents": 384
  },
  "cadence_classes": {
    "streaming": {
      "seconds": 300,
      "mode": "quiet_baseline"
    },
    "fast": {
      "seconds": 900,
      "mode": "quiet_baseline"
    },
    "hourly": {
      "seconds": 3600,
      "mode": "quiet_baseline"
    },
    "six_hour": {
      "seconds": 21600,
      "mode": "digest_baseline"
    },
    "daily": {
      "seconds": 86400,
      "mode": "digest_baseline"
    }
  },
  "ranges": [
    {
      "range": "seismic",
      "baseline_agents": 5,
      "cadence": "fast",
      "domains": [
        "geophysics",
        "earth_hazards"
      ],
