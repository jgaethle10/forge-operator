{
  "schema": "evercraft.machine-rockies.roster.v1",
  "doctrine": {
    "purpose": "Observe machine-visible change, correlate machine behavior, and surface evidence-backed opportunities or anomalies without autonomous external contact.",
    "allowed_source_access": [
      "public",
      "authorized"
    ],
    "data_minimization_required": true,
    "no_auth_bypass": true,
    "no_autonomous_external_contact": true,
    "missing_is_not_negative": true,
    "modeled_is_not_observed": true
  },
  "lanes": [
    {
      "lane": "evercraft-asset-birthwatch",
      "scope": "Evercraft-owned domains, public product surfaces, machine-readable manifests, public APIs, and authorized first-party logs.",
      "cadence": "event_plus_hourly",
      "signal_types": [
        "domain_registration",
        "dns_first_seen",
        "search_index_first_seen",
        "crawler_visit",
        "llm_referral",
        "agent_request",
        "mcp_request"
      ],
      "consumers": [
        "worldstate",
        "chum",
        "signal-fabric"
      ]
    },
    {
      "lane": "machine-campaign-correlation",
      "scope": "Minimized inbound machine-originated outreach and public infrastructure relationships.",
      "cadence": "event",
      "signal_types": [
        "whois_contact",
        "sales_outreach",
        "automated_outreach",
        "api_probe",
        "security_scan"
      ],
      "consumers": [
        "worldstate",
        "sentinel",
        "signal-fabric"
      ]
    },
    {
      "lane": "commercial-change-radar",
      "scope": "Lawful public change signals that may indicate a business is being created, expanding, buying, hiring, permitting, or building.",
      "cadence": "daily_plus_event",
      "signal_types": [
        "company_registration",
        "contractor_license",
        "domain_registration",
        "building_permit",
        "job_posting",
        "google_business_listing",
        "procurement_notice",
        "facility_opening",
        "facility_expansion",
        "ev_charger_application"
      ],
      "consumers": [
        "worldstate",
        "opportunity-fabric",
        "rivet",
        "saban"
      ]
    },
    {
      "lane": "agent-ecosystem-watch",
      "scope": "Public agent, crawler, plugin, LLM, search, MCP, API, and machine-commerce discovery surfaces.",
      "cadence": "hourly",
      "signal_types": [
        "crawler_visit",
        "llm_referral",
        "agent_request",
        "mcp_request",
        "search_index_first_seen"
      ],
      "consumers": [
        "worldstate",
        "chum",
        "fabric",
        "signal-fabric"
      ]
    }
  ]
}\n