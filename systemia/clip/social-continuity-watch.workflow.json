{
  "schema": "evercraft.systemia.workflow-manifest.v1",
  "workflow_key": "evercraft-social-continuity-watch",
  "mission_key": "evercraft-social-distribution-engine-2026-09",
  "runtime": "systemia-core-resident-supervisor",
  "collider_compatible": true,
  "cadence_seconds": 300,
  "material_change_only": false,
  "entrypoint": "systemia/clip/social-continuity-watch.mjs",
  "runner": "systemia/clip/social-continuity-watch.mjs",
  "proof": "tests/clip-social-continuity-watch.test.mjs",
  "inputs": {
    "review_queue": "distribution/marketing/evercraft-problem-first-20261022.review.json",
    "provider_receipt_directory": "artifacts/clip/social-publish-receipts",
    "receipt_directory_override": "SYSTEMIA_CLIP_SOCIAL_RECEIPTS_DIR"
