    "rules_research": "autonomous",
    "fit_analysis": "autonomous",
    "build_and_test": "autonomous",
    "raven_qa": "autonomous_required",
    "packaging": "autonomous",
    "provider_executor_repair": "autonomous_safe_only",
    "submission": "autonomous_when_pre_authorized_and_provider_receipt_verifiable",
