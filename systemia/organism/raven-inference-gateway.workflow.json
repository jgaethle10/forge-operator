{
  "schema": "evercraft.systemia.workflow-manifest.v1",
  "workflow_key": "raven-inference-gateway",
  "mission_key": "raven-inference-gateway-owned-2026-10-05",
  "runtime": "systemia-core+evercraft-compute",
  "collider_compatible": true,
  "material_change_only": false,
  "entrypoint": "systemia/raven/inference-gateway.mjs",
  "runner": "systemia/raven/inference-gateway-runner.mjs",
  "proof": "systemia/raven/inference-gateway.test.mjs",
  "authority": {
    "model_inference": "internal_read_only_only",
    "provider_selection": "runtime_configured",
    "external_communication": "held",
    "publication": "held",
    "payment": "held",
    "purchase": "held",
    "deployment": "held",
    "account_mutation": "held",
    "model_metadata_validation": "internal_non_inference"
  },
  "network": {
    "bind": "127.0.0.1",
    "default_port": 4322,
    "public_bind_allowed": false,
    "base44_required": false
  },
  "providers": {
    "ollama": {
      "credential_required": false,
      "default_origin": "http://127.0.0.1:11434",
      "model_required": true
    },
    "gemini": {
      "credential_provider": "gemini",
      "credential_vault": "evercraft-owned",
      "model_required": true
    },
    "openai": {
      "credential_provider": "openai",
      "credential_vault": "evercraft-owned",
      "api": "responses",
      "model_required": true
    }
  },
  "secret_boundary": {
    "gateway_authority_token_source": "private_file",
    "provider_credentials_source": "owned_encrypted_vault",
    "raw_tokens_in_cli_args": false,
    "raw_provider_credentials_in_receipts": false
  },
  "validation": {
    "endpoint": "POST /v1/validate",
    "provider_calls": {
      "ollama": "local model inventory",
      "gemini": "models.get",
      "openai": "retrieve model"
    },
    "prompt_sent": false,
    "inference_performed": false,
    "base44_fallback": false
  }
}
