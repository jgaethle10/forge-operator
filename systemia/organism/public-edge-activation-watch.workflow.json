{
  "schema": "evercraft.systemia.workflow-manifest.v1",
  "workflow_key": "public-edge-activation-watch",
  "mission_key": "evercraft-public-fabric-edge",
  "runtime": "systemia-organism+collider",
  "collider_compatible": true,
  "cadence_seconds": 300,
  "material_change_only": true,
  "runner": "systemia/organism/public-edge-activation-watch-runner.mjs",
  "proof": "systemia/organism/public-edge-activation-watch.proof.mjs",
  "notification_policy": {
    "chat_scheduler": false,
    "notify_only_on_material_change": true
  },
  "authority": {
    "discover_authorized_capacity": "autonomous",
    "allocate_bounded_compute_lease": "autonomous_with_existing_allocator_authority",
    "initial_deploy_read_only_specialist_runtime": "autonomous",
    "initial_deploy_public_edge": "autonomous_after_node_tls_admission",
    "initial_bind_public_route": "autonomous_after_receipt_and_instance_match",
    "post_activation_continuity_owner": "public-edge-controller",
    "external_https_promotion": "external_canary_required",
    "registry_publication": "systemia_release_policy",
    "founder_login_required": false,
    "payment_authority": false,
    "initial_deploy_control_room_browser": "autonomous_after_node_tls_admission",
    "initial_deploy_evercraft_home": "autonomous_after_node_tls_and_home_identity_admission"
  },
  "outputs": {
    "cycle_report": "artifacts/public-edge-activation-watch/latest.json",
    "mission_snapshot": "artifacts/public-edge-activation-watch/mission-snapshot.json",
    "safe_state": "artifacts/public-edge-activation-watch/runtime/public-edge-activation-watch.json",
    "field_mission": "artifacts/public-edge-activation-watch/field-mission.json",
    "field_mission_snapshot": "artifacts/public-edge-activation-watch/field-mission-snapshot.json"
  },
  "private_runtime_inputs": {
    "allocator_authority": "EVERCRAFT_ALLOCATOR_TOKEN or EVERCRAFT_ALLOCATOR_TOKENS_JSON",
    "release_ref": "EVERCRAFT_RELEASE_REF or current git HEAD",
    "discovery": "Evercraft capacity beacons",
    "persistence_root": "EVERCRAFT_PUBLIC_EDGE_STATE_DIR optional",
    "openai_challenge_token": "OPENAI_APPS_CHALLENGE_TOKEN; consumed in memory only and never persisted",
    "fabric_hostname": "EVERCRAFT_PUBLIC_EDGE_REQUESTED_HOSTNAME optional; defaults to evercraft-fabric and uses a stable hostname lease",
    "control_room_hostname": "EVERCRAFT_CONTROL_ROOM_HOSTNAME optional; defaults to evercraft-control and uses a stable hostname lease",
    "control_room_concurrency": "EVERCRAFT_CONTROL_ROOM_MAX_CONCURRENCY optional; defaults to 2",
    "home_public_edge_enabled": "EVERCRAFT_HOME_PUBLIC_EDGE_ENABLED optional; defaults to true",
    "home_hostname": "EVERCRAFT_HOME_HOSTNAME optional; defaults to home and uses a stable hostname lease"
  },
  "collider": {
    "heartbeat_seconds": 300,
    "mission_snapshot_schema": "evercraft.kaidance.mission-snapshot.v1",
    "material_change_only": true
  },
  "promotion_policy": {
    "direct_mcp_promotion_requires_external_canary": true,
    "official_registry_publication_requires_release_policy": true,
    "no_base44_public_edge": true,
    "no_founder_auth_loop": true,
    "fabric_mcp_external_canary_required": true,
    "control_room_public_https_external_canary_required": true,
    "evercraft_home_public_https_external_canary_required": true
  },
  "role": "discovery_and_initial_activation_owner",
  "activation_owner": "public-edge-activation-watch",
  "maintenance_owner": "public-edge-controller",
  "handoff_policy": {
    "after_successful_activation": "public-edge-controller owns 60-second continuity for Fabric, Control Room, and Evercraft Home stable-hostname leases",
    "on_hold": "activation watch retries on Collider heartbeat only when state may have changed",
    "duplicate_provisioning": false
  },
  "issue_ref": "github:issue:403",
  "dependency_issue_ref": "github:issue:175",
  "dependency_state_required": "any_authorized_field_capacity_verified",
  "current_truth": {
    "software_path": "ci_proven",
    "public_production_edge": "not_verified",
    "physical_dependency": "any authorized field capacity with public HTTPS admission, owned browser workload, and Evercraft Home identity readiness",
    "control_room_software_path": "ci_proven_and_activation_integrated",
    "control_room_public_production_edge": "not_verified",
    "evercraft_home_software_path": "ci_proven_and_activation_integrated",
    "evercraft_home_public_production_edge": "not_verified"
  },
  "dependencies": {
    "node001_field_mission": "optional legacy candidate evidence at artifacts/node001-field/evernode-one-status/latest.json",
    "node001_issue": "github:issue:175",
    "public_edge_issue": "github:issue:403",
    "direct_plugin_specs": "distribution/direct-plugin-specs.json"
  }
}
