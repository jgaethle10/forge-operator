{
  "schema": "evercraft.systemia.workflow-manifest.v1",
  "workflow_key": "competition-saban-capacity",
  "mission_key": "competition-autonomous-capacity-v1",
  "runtime": "systemia-organism+resident-supervisor",
  "collider_compatible": true,
  "cadence_seconds": 300,
  "material_change_only": true,
  "entrypoint": "systemia/competition/saban-capacity-runner.mjs",
  "proof": "tests/competition-saban-capacity.test.mjs",
  "notification_policy": {
    "chat_scheduler": false,
    "notify_only_on_material_change": true,
    "human_gate_only": true
  },
  "authority": {
    "capacity_discovery": "autonomous",
    "owned_or_authorized_zero_cost_lease": "autonomous",
    "competition_browser_deployment": "autonomous_after_immutable_release_binding",
    "commercial_quote": "visibility_only",
    "paid_lease": "human_gate",
    "payment_or_staking": "human_gate"
  },
  "outputs": {
    "capacity_receipt": "artifacts/competition-provider/capacity/latest.json"
  },
  "routing": {
    "canonical_path": [
      "systemia",
      "competition_control_plane",
      "saban",
      "yard",
      "evercraft_compute",
      "competition_browser_worker"
    ],
    "base44_allowed": false,
    "public_fabric_transit_allowed": false
  },
  "safety": {
    "zero_spend_default": true,
    "accept_new_terms": false,
    "stake_funds": false,
    "create_financial_obligation": false,
    "paid_market_order": false,
    "paid_lease": false,
    "persist_allocator_token": false,
    "claim_capacity_without_attestation": false
  }
}
