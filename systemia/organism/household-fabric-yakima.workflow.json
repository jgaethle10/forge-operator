  "outputs": {
    "cycle_report": "artifacts/household-fabric/yakima/latest.json",
    "ledger": "artifacts/household-fabric/yakima/ledger.json",
    "today": "artifacts/household-fabric/yakima/today.json",
    "mission_snapshot": "artifacts/household-fabric/yakima/mission-snapshot.json",
