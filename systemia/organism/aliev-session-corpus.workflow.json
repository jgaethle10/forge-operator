{
  "schema": "evercraft.systemia.workflow-manifest.v1",
  "workflow_key": "aliev-session-corpus",
  "mission_key": "rivet-us-session-sprawl-001",
  "runtime": "systemia-core-cycle",
  "collider_compatible": true,
  "cadence_seconds": 300,
  "entrypoint": "systemia/aliev/session-corpus-runner.mjs",
  "proof": "systemia/aliev/session-corpus.proof.mjs",
  "authority": {
    "read_public_session_sources": "autonomous",
    "write_owned_session_partitions": "autonomous",
    "write_owned_observed_usage_projections": "autonomous_after_hash_verification",
    "persist_personal_driver_identifiers": false,
    "use_base44_as_runtime": false,
    "create_payment_obligation": false,
    "external_outreach": false,
    "purchase_licensed_data": false
