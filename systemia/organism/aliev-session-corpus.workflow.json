  "truth_gates": [
    "source_is_public_or_explicitly_authorized",
    "privacy_minimized_source_selection",
    "content_hash_verified_partition",
    "checkpoint_receipt",
    "invalid_and_aborted_not_promoted_to_successful_usage",
    "missing_is_not_zero"
  ],
  "outputs": {
    "checkpoint": "artifacts/aliev-session-corpus/session-corpus/nyc-plugnyc/checkpoint.json",
    "receipts": "artifacts/aliev-session-corpus/session-corpus/nyc-plugnyc/receipts.jsonl",
    "owned_object_store": "artifacts/aliev-session-corpus/object-store",
    "owned_entity_store": "artifacts/aliev-session-corpus/entity-store"
  },
  "maintenance_owner": "systemia"
}
