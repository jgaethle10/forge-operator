    },
    {
      "id": "kdenlive",
      "repo": "KDE/kdenlive",
      "commit": "00141d89668d2519d48cc12b0b001ae34b72cf42",
      "license": "GPL-3.0",
      "role": "optional editor with GUI on user-owned machine",
      "executor": "kdenlive",
      "stage": "discovery-only",
      "requiresGPU": false
    },
    {
      "id": "mlt",
      "repo": "mltframework/mlt",
      "commit": "2a51ed9cca0b7edca5f1c34749bad67b76b0051a",
      "license": "LGPL-2.1 (recheck plugin/component variations)",
