      "role": "local media encode / decode / probe",
      "executor": "ffmpeg",
      "stage": "existing-in-fallen",
      "requiresGPU": false
    },
    {
      "id": "opentimelineio",
      "repo": "AcademySoftwareFoundation/OpenTimelineIO",
      "commit": "bad7ab5a40ac1a95d9d78a87c95a688d8b57cf28",
