{
  "schema": "evercraft.fallen.open-source-toolchain.v1",
  "scope": "Evercraft || Fallen Studios | local execution only",
  "policy": {
    "repositoryMirrorIsNotInstallation": true,
    "canRunOnOwnerHardwareOnly": true,
    "systemiaOwnerOfRouting": true,
    "sabanOperatorForAdmittedTasks": true,
    "thirdPartyHostedExecution": false,
    "automaticSpend": false,
    "automaticPublication": false,
    "modelWeightsSeparateRightsReview": true,
    "binaryLicenseAuditRequired": true
  },
  "tools": [
