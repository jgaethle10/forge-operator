      "license": "Apache-2.0",
      "role": "professional timeline interchange .otio",
      "executor": "otio_bridge.py",
      "stage": "v1-ci-verification",
      "requiresGPU": false
    },
    {
      "id": "blender",
      "repo": "blender/blender",
      "commit": "7539ade214fb5971c4c39430362fd9f8f07da600",
      "license": "GPL family (review bundled components before binary redistribution)",
      "role": "owned 3D scene + VFX rendering",
      "executor": "blender",
      "stage": "capability-discovery-only",
      "requiresGPU": false
    },
    {
      "id": "comfyui",
      "repo": "Comfy-Org/ComfyUI",
      "commit": "e9afbccc2669677076feb08e52658f129cd8c12b",
      "license": "GPL-3.0; model and custom nodes have independent terms",
      "role": "node-graph image/video inference behind verified local worker",
      "executor": "comfyui-loopback",
