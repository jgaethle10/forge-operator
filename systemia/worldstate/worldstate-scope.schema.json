{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evercraft.example/schemas/worldstate-scope-v1.json",
  "title": "Evercraft Worldstate Scope v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "region_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "materiality_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "people"
        ]
      }
    },
    {
      "not": {
        "required": [
          "person_ids"
        ]
      }
    },
    {
      "not": {
        "required": [
          "individuals"
        ]
      }
    }
  ]
}
