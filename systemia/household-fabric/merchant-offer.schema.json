{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Systemia Household Fabric Merchant Offer",
  "type": "object",
  "required": [
    "merchant_id",
    "merchant_name",
    "offer_id",
    "title",
    "category",
    "valid_from",
    "expires_at",
    "locations",
    "attestation"
  ],
  "properties": {
    "merchant_id": {
      "type": "string",
      "minLength": 1
    },
    "merchant_name": {
      "type": "string",
      "minLength": 1
    },
    "offer_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "category": {
      "enum": [
        "grocery",
        "retail",
        "meal",
        "service",
        "other"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "regular_price_cents": {
      "type": "integer",
      "minimum": 0
    },
    "offer_price_cents": {
      "type": "integer",
      "minimum": 0
    },
    "terms": {
      "type": "string"
    },
    "eligibility": {
      "enum": [
        "verified",
        "likely",
        "unknown"
      ]
    },
    "inventory_state": {
      "enum": [
        "in_stock",
        "limited",
        "appointment",
        "unknown"
      ]
    },
    "offer_url": {
      "type": "string"
    },
    "holiday_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audience_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sponsored": {
      "type": "boolean"
    },
    "sponsor_label": {
      "type": "string"
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "location_id",
          "label"
        ],
        "properties": {
          "location_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "long": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "additionalProperties": false
      }
    },
    "attestation": {
      "type": "object",
      "required": [
        "submission_id",
        "submitted_at",
        "submitted_by"
      ],
      "properties": {
        "submission_id": {
          "type": "string",
          "minLength": 1
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "submitted_by": {
          "type": "string",
          "minLength": 1
        },
        "signature_state": {
          "enum": [
            "unsigned",
            "verified"
          ]
        },
        "signature_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
