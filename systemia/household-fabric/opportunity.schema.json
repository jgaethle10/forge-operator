{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Systemia Household Fabric Opportunity",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "observed_at",
    "evidence_state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "fuel",
        "grocery",
        "retail",
        "meal",
        "event",
        "job",
        "gig",
        "rebate",
        "benefit",
        "utility",
        "transit",
        "service",
        "other"
      ]
    },
    "source_url": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_state": {
      "enum": [
        "observed",
        "public",
        "licensed",
        "modeled",
        "inferred",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "distance_miles": {
      "type": "number",
      "minimum": 0
    },
    "travel_minutes": {
      "type": "number",
      "minimum": 0
    },
    "action_minutes": {
      "type": "number",
      "minimum": 0
    },
    "action_steps": {
      "type": "integer",
      "minimum": 0
    },
    "gross_savings_cents": {
      "type": "integer",
      "minimum": 0
    },
    "gross_earnings_cents": {
      "type": "integer",
      "minimum": 0
    },
    "eligibility": {
      "enum": [
        "verified",
        "likely",
        "unknown",
        "ineligible"
      ]
    },
    "audience_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "holiday_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sponsored": {
      "type": "boolean"
    },
    "sponsor_label": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "source_url"
      ]
    },
    {
      "required": [
        "source_id"
      ]
    }
  ],
  "additionalProperties": true
}
