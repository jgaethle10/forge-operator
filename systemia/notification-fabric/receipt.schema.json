{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evercraft.example/schemas/systemia.notification.delivery.v3.json",
  "title": "Evercraft Relay Delivery Receipt",
  "type": "object",
  "required": [
    "schema",
    "notification_id",
    "status",
    "at",
    "receipt_hash"
  ],
  "properties": {
    "schema": {
      "enum": [
        "systemia.notification.delivery.v2",
        "systemia.notification.delivery.v3"
      ]
    },
    "notification_id": {
      "type": "string",
      "minLength": 1
    },
    "subscription_id": {
      "type": "string"
    },
    "principal_id": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "status": {
      "enum": [
        "deduped",
        "no_target",
        "expired",
        "inboxed",
        "delivered_realtime",
        "push_suppressed",
        "accepted_by_push_gateway",
        "delivery_failed",
        "human_seen",
        "human_acknowledged",
        "ack_watch_satisfied",
        "ack_watch_expired",
        "ack_escalated"
      ]
    },
    "reason": {
      "type": "string"
    },
    "http_status": {
      "type": "integer"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "connections": {
      "type": "integer",
      "minimum": 0
    },
    "at": {
      "type": "string"
    },
    "prev_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "receipt_hash": {
      "type": "string",
      "minLength": 32
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "escalation_level": {
      "type": "integer",
      "minimum": 1
    },
    "escalation_notification_id": {
      "type": "string"
    },
    "principal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
