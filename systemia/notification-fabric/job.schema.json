{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evercraft.example/schemas/systemia.relay.job.v1.json",
  "title": "Evercraft Relay Durable Job",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "status",
    "attempts",
    "max_attempts",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": {
      "const": "systemia.relay.job.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "intent",
        "signal",
        "ack_watch"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "processing",
        "retry",
        "completed",
        "dead_letter"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "not_before_at": {
      "type": "string"
    },
    "lease_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {},
    "recovery_count": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "dead_lettered_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "failures": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
