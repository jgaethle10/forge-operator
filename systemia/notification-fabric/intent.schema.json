{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evercraft.example/schemas/systemia.notification.intent.v2.json",
  "title": "Evercraft Relay Notification Intent",
  "type": "object",
  "required": [
    "product",
    "purpose",
    "title",
    "body"
  ],
  "properties": {
    "schema": {
      "const": "systemia.notification.intent.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "purpose": {
      "enum": [
        "transactional",
        "operational",
        "safety",
        "reminder",
        "marketing"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "recipient_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "maxItems": 500
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "data": {
      "type": "object",
      "x-evercraft-maxBytes": 16384
    },
    "evidence_state": {
      "type": "string",
      "maxLength": 120
    },
    "consent_basis": {
      "type": "string",
      "maxLength": 120
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2419200
    },
    "dedupe_key": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "dedupe_window_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string"
    },
    "acknowledgement": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "any",
            "all"
          ]
        },
        "within_seconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 604800
        },
        "max_escalations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "escalation_interval_seconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 86400
        },
        "title_prefix": {
          "type": "string",
          "maxLength": 40
        },
        "due_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "required"
      ],
      "additionalProperties": false
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Business freshness deadline. Relay must not deliver or escalate the event after this instant."
    },
    "icon": {
      "type": [
        "string",
        "null"
      ]
    },
    "badge": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
