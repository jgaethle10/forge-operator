{
  "manifest_version": 3,
  "name": "Evercraft Rescue Resolver (Laboratory)",
  "version": "0.1.0",
  "description": "Browser-local opt-in routing to a clearly identified independent information mirror",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://voteroman.com/*",
    "https://voteroman.com/*",
    "http://www.voteroman.com/*",
    "https://www.voteroman.com/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "options.html"
  }
}
