{
  "schema": "evercraft.opportunity-fabric.policy.v1",
  "policy_name": "Evercraft Creator Covenant",
  "version": "0.1.0-draft",
  "status": "draft_for_counsel_review",
  "production_legal_review_required": true,
  "principles": {
    "owner_retains_rights": true,
    "upload_transfers_ownership": false,
    "viewing_grants_commercial_license": false,
    "match_requires_protected_content": false,
    "recipient_identity_required_before_disclosure": true,
    "owner_approval_required_before_disclosure": true,
    "covenant_acceptance_required_before_disclosure": true,
    "receipt_required_for_every_disclosure": true,
    "joint_work_allocation_required_before_creation": true
  },
  "default_evaluation_license": {
    "allowed": [
      "evaluate_fit",
      "prepare_quote",
      "prepare_proposal",
      "assess_production_feasibility",
      "assess_collaboration_fit"
    ],
    "prohibited_without_separate_explicit_license": [
      "commercial_production",
      "publication",
      "sale",
      "resale",
      "distribution",
      "sublicensing",
      "ai_training",
      "model_fine_tuning",
      "embedding_corpus_creation",
      "derivative_commercialization",
      "independent_reproduction",
      "reverse_engineering_for_competitive_use",
      "circumvention"
    ]
  },
  "confidentiality": {
    "protected_material_use_limited_to_accepted_purpose": true,
    "redisclosure_prohibited_without_owner_authorization": true,
    "access_revocation_supported": true,
    "retention_and_deletion_terms_required_in_final_agreement": true
  },
  "non_circumvention": {
    "required_in_final_agreement": true,
    "description": "Participants may not use protected opportunity information obtained through the fabric to bypass the originating party contrary to the accepted agreement."
  },
  "collaboration": {
    "pre_creation_allocation_fields": [
      "background_ip_owner",
      "new_work_ownership",
      "license_scope",
      "revenue_split",
      "credit",
      "territory",
      "duration",
      "derivative_rights"
    ],
    "multi_party_contract": "multi-party.md",
    "work_package_fields": [
      "team_id",
      "assignee",
      "title",
      "capability_required",
      "safe_input_summary",
      "output_definition",
      "dependencies",
      "economics",
      "due_date",
      "protected_material_required"
    ]
  },
  "receipt": {
    "required_fields": [
      "receipt_id",
      "asset_id",
      "asset_fingerprint",
      "owner_id",
      "recipient_id",
      "purpose",
      "agreement_version",
      "agreement_accepted_at",
      "owner_approved_at",
      "disclosed_at"
    ],
    "tamper_evidence": "sha256",
    "digital_signature_required_for_production": true
  },
  "counsel_review_scope": [
    "electronic_assent",
    "confidentiality",
    "trade_secret_preservation",
    "copyright_and_license",
    "non_circumvention",
    "joint_authorship_and_work_for_hire",
    "remedies_and_damages",
    "dispute_resolution",
    "governing_law",
    "jurisdiction",
    "record_retention",
    "privacy_and_data_processing"
  ],
  "runtime_authority": {
    "protected_workflow_direct_client_mutation": false,
    "trusted_runtime_required": true,
    "service_role_reverifies_identity_and_state": true,
    "client_supplied_identity_or_consent_not_authoritative": true
  },
  "multi_party": {
    "enabled_in_verified_private_runtime": true,
    "team_sources_must_be_accepted_connections": true,
    "counterparties_derived_server_side": true,
    "counterparties_deduplicated": true,
    "project_specific_team_invitation_required": true,
    "work_package_requires_accepted_team_invitation": true,
    "leader_controls_scope_and_economics": true,
    "assignee_controls_acceptance_and_progress": true,
    "team_membership_grants_ip_rights": false,
    "work_package_acceptance_grants_ip_rights": false,
    "protected_material_may_be_flagged_required_without_disclosure": true,
    "protected_material_disclosed_by_team_flow": false,
    "protected_file_delivery_enabled": false
  },
  "execution_planning": {
    "enabled_in_verified_private_runtime": true,
    "project_owner_required": true,
    "source_safe_metadata_only": true,
    "project_fields_used": [
      "need",
      "looking_for",
      "have",
      "title",
      "description",
      "location",
      "protected_material_present"
    ],
    "member_fields_used": [
      "can_do",
      "have",
      "tags",
      "specialty",
      "role",
      "location",
      "name",
      "protected_material_present"
    ],
    "protected_workflow_records_used": false,
    "contact_information_returned": false,
    "protected_content_used": false,
    "missing_capabilities_preserved": true,
    "recommendation_is_not_membership": true,
    "recommendation_grants_rights": false,
    "candidate_connection_still_requires_protected_handshake": true,
    "ledger": {
      "entity": "ExecutionBlueprint",
      "owner_private_read": true,
      "direct_client_mutation": false,
      "trusted_runtime_write_required": true,
      "deterministic_plan_id": true,
      "identical_evidence_idempotent_replay": true,
      "fabric_event_receipt_link_required": true,
      "protected_content_stored": false,
      "private_contact_information_stored": false
    }
  },
  "sourcing": {
    "enabled_in_verified_private_runtime": true,
    "accepted_connection_required": true,
    "bound_to_execution_blueprint": true,
    "candidate_must_exist_in_blueprint_package": true,
    "safe_scope_only": true,
    "protected_material_disclosed": false,
    "response_fields": [
      "availability_response",
      "quote_mode",
      "quote_amount",
      "quote_currency",
      "lead_time_days",
      "available_from",
      "valid_until",
      "response_note"
    ],
    "payment_obligation_created": false,
    "quote_response_is_contract": false,
    "shortlisting_creates_team_membership": false,
    "sourced_team_requires_requester_shortlist": true,
    "sourced_team_requires_availability": [
      "Available",
      "Limited"
    ],
    "sourced_team_single_project_and_blueprint": true,
    "team_acceptance_materializes_work_package_as": "Offered",
    "work_package_acceptance_still_required": true
  },
  "sourcing_comparison": {
    "enabled_in_verified_private_runtime": true,
    "owner_only": true,
    "same_project_blueprint_and_package": true,
    "eligible_availability": [
      "Available",
      "Limited"
    ],
    "weights": {
      "price": 0.3,
      "lead_time": 0.25,
      "availability": 0.15,
      "observed_fabric_history": 0.2,
      "geography": 0.1
    },
    "evidence_states": {
      "quote": "participant_supplied_quote",
      "lead_time": "participant_supplied",
      "availability": "participant_supplied",
      "history": "observed_fabric_history_or_neutral_missing",
      "geography": "profile_metadata_or_insufficient_metadata"
    },
    "missing_history_is_neutral": true,
    "missing_numeric_values_are_not_zero": true,
    "cross_currency_price_normalization": false,
    "price_peer_group_same_currency_only": true,
    "human_decision_required": true,
    "selected_partner_created": false,
    "creates_payment_obligation": false,
    "grants_rights": false,
    "creates_team_membership": false,
    "ledger": {
      "entity": "SourcingComparison",
      "owner_private_read": true,
      "direct_client_mutation": false,
      "trusted_runtime_write_required": true,
      "deterministic_comparison_id": true,
      "identical_evidence_idempotent_replay": true,
      "fabric_event_receipt_link_required": true
    }
  }
}
