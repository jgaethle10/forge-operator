{
  "schema": "evercraft.systemia.base44-exit-policy.v1",
  "status": "active",
  "effective_date": "2026-09-24",
  "destinations": {
    "canonical_source": "github",
    "orchestration": "systemia",
    "runtime": "yard_evercraft_compute",
    "base44": "legacy_extraction_compatibility_only"
  },
  "invariants": {
    "new_base44_apps": false,
    "base44_as_new_runtime_target": false,
    "base44_as_canonical_source": false,
    "secrets_in_public_github": false,
    "private_core_source_in_public_repo": false,
    "migration_expands_authority": false,
    "payment_requires_explicit_confirmation": true,
    "revenue_requires_provider_verified_payment": true
  },
  "cutover_required_evidence": [
    "source_extracted",
    "dependencies_enumerated",
    "data_reconciled",
    "auth_parity_verified",
    "integration_parity_verified",
    "tests_pass",
    "immutable_release_ref",
    "yard_deployment_receipt",
    "health_pass",
    "route_verification_pass",
    "rollback_target_present",
    "observation_window_pass",
    "route_inventory_captured",
    "data_snapshot_verified",
    "delta_sync_or_write_freeze_verified",
    "secrets_rekeyed",
    "critical_journey_parity_pass",
    "observability_ready",
    "post_cutover_sentinel_ready",
    "realtime_parity_if_required"
  ],
  "priority": [
    "systemia_core_and_kaidance_collider",
    "shared_capability_registry_and_execution_receipts",
    "machine_commerce_and_discovery_edges",
    "shared_auth_data_and_integration_adapters",
    "revenue_critical_products",
    "safety_family_and_continuity_products",
    "research_media_atlas_and_long_tail"
  ],
  "retirement_rule": "Retire a Base44 dependency only after its named replacement is live, independently verified, reconciled and rollback-safe.",
  "factory": {
    "contract": "systemia/migrations/base44-exit/factory/contract.mjs",
    "runner": "systemia/migrations/base44-exit/factory/runner.mjs",
    "saban_software_id": "base44-evac",
    "source_mode": "read_only_until_separate_decommission_gate",
    "private_inventory_required": true,
    "public_source_identifiers_allowed": false
  },
  "shared_landing_primitives": [
    "app_fabric_compatibility",
    "public_edge",
    "yard_runtime",
    "canonical_data",
    "identity_boundary",
    "secret_store",
    "object_storage",
    "resident_scheduler",
    "connector_gateway",
    "webhook_gateway",
    "commerce_boundary",
    "fabric_discovery",
    "portfolio_sentinel",
    "realtime_bus",
    "source_dependency_scanner",
    "lossless_entity_transfer",
    "identity_challenge_broker"
  ],
  "landing_implementations": {
    "app_fabric_compatibility": {
      "state": "owned_baseline_proved_local",
      "source_refs": [
        "systemia/app-fabric/client.mjs",
        "systemia/app-fabric/gateway.mjs",
        "systemia/app-fabric/query.mjs",
        "systemia/app-fabric/base44-sdk-compat.mjs",
        "systemia/app-fabric/base44-sdk-compat.proof.mjs"
      ],
      "boundary": "Compatibility covers observed Base44 SDK call geometry. Product-specific unsupported calls and hard-coded legacy routes remain explicit migration blockers."
    },
    "canonical_data": {
      "state": "owned_baseline_proved_local",
      "source_refs": [
        "systemia/app-fabric/entity-store.mjs"
      ],
      "boundary": "Higher-volume or distributed workloads require a stronger backing implementation behind the same compatibility contract before cutover."
    },
    "identity_boundary": {
      "state": "owned_baseline_proved_local",
      "source_refs": [
        "systemia/identity/identity.mjs",
        "systemia/identity/challenge-broker.mjs",
        "systemia/app-fabric/identity-adapter.mjs",
        "systemia/passport/passport.mjs"
      ],
      "boundary": "Identity and session issuance are owned. Registration/recovery remain fail-closed until a real delivery adapter returns a receipt. Legacy credentials are not copied."
    },
    "public_edge": {
      "state": "owned",
      "source_refs": [
        "systemia/yard/public-route-broker.mjs",
        "systemia/yard/public-edge-controller.mjs"
      ]
    },
    "yard_runtime": {
      "state": "owned",
      "source_refs": [
        "systemia/yard/operator.mjs"
      ]
    },
    "portfolio_sentinel": {
      "state": "owned",
      "source_refs": [
        "systemia/organism/portfolio-sentinel-runner.mjs",
        "systemia/organism/portfolio-sentinel.workflow.json"
      ]
    },
    "realtime_bus": {
      "state": "owned_baseline_proved_local",
      "source_refs": [
        "systemia/realtime-bus/realtime-bus.mjs",
        "systemia/app-fabric/gateway.mjs",
        "systemia/app-fabric/client.mjs"
      ],
      "boundary": "Durable hash-chained sequence log plus authorized resumable SSE baseline. Product-specific realtime semantics still require parity."
    },
    "secret_store": {
      "state": "owned_baseline_proved_local",
      "source_refs": [
        "systemia/secret-store/secret-store.mjs"
      ],
      "boundary": "Master encryption key is supplied out of band and is never persisted by the store. Provider credentials are re-issued rather than copied from Base44."
    },
    "object_storage": {
      "state": "owned_baseline_proved_local",
      "source_refs": [
        "systemia/object-store/object-store.mjs"
      ],
      "boundary": "Content-addressed local baseline with app-scoped references and integrity checks. Replication and geographic requirements remain app-specific cutover gates."
    },
    "source_dependency_scanner": {
      "state": "owned_baseline_proved_local",
      "source_refs": [
        "systemia/migrations/base44-exit/source-scanner.mjs",
        "systemia/migrations/base44-exit/source-scanner.proof.mjs"
      ],
      "boundary": "Scans extracted source for migration dependencies while redacting cross-app identifiers, environment values and hard-coded legacy route values."
    },
    "lossless_entity_transfer": {
      "state": "owned_baseline_proved_local",
      "source_refs": [
        "systemia/migrations/base44-exit/entity-transfer.mjs",
        "systemia/migrations/base44-exit/entity-transfer.proof.mjs",
        "systemia/app-fabric/entity-store.mjs",
        "systemia/object-store/object-store.mjs"
      ],
      "boundary": "Requires terminal pagination, immutable page hashes, whole-stream reconciliation, idempotent import and destination field verification. Transfer receipts do not authorize traffic cutover."
    },
    "identity_challenge_broker": {
      "state": "owned_baseline_proved_local",
      "source_refs": [
        "systemia/identity/challenge-broker.mjs",
        "systemia/secret-store/secret-store.mjs"
      ],
      "boundary": "Pending registration credentials are encrypted; OTPs and reset tokens are hash-only at rest. No successful delivery state exists without a delivery receipt."
    }
  }
}
