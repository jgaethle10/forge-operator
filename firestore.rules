rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Schema Validation Helpers
    function isValidUserProfile(data, userId) {
      return data.uid is string &&
        data.uid == userId &&
        data.email is string &&
        data.email.size() <= 128 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        data.createdAt is string &&
        data.createdAt.size() <= 64 &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64));
    }

    function isValidUserReport(data, userId) {
      return data.id is string &&
        isValidId(data.id) &&
        data.userId is string &&
        data.userId == userId &&
        data.businessProblem is string &&
        data.businessProblem.size() <= 4000 &&
        data.desiredOutcome is string &&
        data.desiredOutcome.size() <= 4000 &&
        (!('businessContext' in data) || (data.businessContext is string && data.businessContext.size() <= 4000)) &&
        data.report is map &&
        data.createdAt is string &&
        data.createdAt.size() <= 64;
    }

    // Users collection and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Diagnostic reports subcollection
      match /reports/{reportId} {
        allow get: if isOwner(userId) && isValidId(reportId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidId(reportId) &&
          isValidUserReport(incoming(), userId);
        allow update: if isOwner(userId) &&
          isValidId(reportId) &&
          isValidUserReport(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(reportId);
      }
    }
  }
}
